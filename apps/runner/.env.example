# The sandbox runner (ADR-0016). `pnpm env:init` copies this to apps/runner/.env.
# Variables already set in the environment win over this file.

# Shared with the API: apps/api/.env must hold the same value. At least 32 characters; never commit
# it. `pnpm env:init` fills both files with one random token when both are still empty.
RUNNER_TOKEN=

# Where it listens. Keep it on a private address: only the API should reach it.
RUNNER_HOST=127.0.0.1
RUNNER_PORT=4100

# The image every job runs in: docker build -t lms-sandbox:1 infra/sandbox
RUNNER_IMAGE=lms-sandbox:1

# Jobs at once (one CPU each), and how many more may wait before callers are told to retry.
RUNNER_CONCURRENCY=2
RUNNER_QUEUE=32
