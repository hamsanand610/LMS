      "patch": {
        "operationId": "BrandingController_update",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "brandName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "tagline": {
                    "default": "",
                    "type": "string",
                    "maxLength": 120
                  },
                  "logoLightFileId": {
                    "default": null,
                    "nullable": true,
                    "type": "string"
                  },
                  "logoDarkFileId": {
                    "default": null,
                    "nullable": true,
                    "type": "string"
                  },
                  "faviconFileId": {
                    "default": null,
                    "nullable": true,
                    "type": "string"
                  },
                  "primaryColor": {
                    "type": "string",
                    "pattern": "^#([0-9a-fA-F]{6})$"
                  },
                  "accentColor": {
                    "default": null,
                    "nullable": true,
                    "type": "string",
                    "pattern": "^#([0-9a-fA-F]{6})$"
                  },
                  "fontUi": {
                    "default": "ibm-plex-sans",
                    "type": "string",
                    "enum": [
                      "system",
                      "ibm-plex-sans",
                      "inter",
                      "manrope",
                      "source-sans-3",
                      "noto-sans"
                    ]
                  },
                  "radius": {
                    "default": "md",
                    "type": "string",
                    "enum": ["none", "sm", "md", "lg"]
                  },
                  "density": {
                    "default": "comfortable",
                    "type": "string",
                    "enum": ["comfortable", "compact"]
                  },
                  "login": {
                    "default": {
                      "layout": "split",
                      "welcomeTitle": "Welcome back",
                      "welcomeText": "",
                      "backgroundFileId": null
                    },
                    "type": "object",
                    "properties": {
                      "layout": {
                        "default": "split",
                        "type": "string",
                        "enum": ["split", "centered"]
                      },
                      "welcomeTitle": {
                        "default": "Welcome back",
                        "type": "string",
                        "maxLength": 80
                      },
                      "welcomeText": {
                        "default": "",
                        "type": "string",
                        "maxLength": 240
                      },
                      "backgroundFileId": {
                        "default": null,
                        "nullable": true,
                        "type": "string"
                      }
                    }
                  },
                  "dashboard": {
                    "default": {
                      "welcomeText": ""
                    },
                    "type": "object",
                    "properties": {
                      "welcomeText": {
                        "default": "",
                        "type": "string",
                        "maxLength": 160
                      }
                    }
                  },
                  "email": {
                    "default": {
                      "footerText": "",
                      "supportEmail": null
                    },
                    "type": "object",
                    "properties": {
                      "footerText": {
                        "default": "",
                        "type": "string",
                        "maxLength": 240
                      },
                      "supportEmail": {
                        "default": null,
                        "nullable": true,
                        "type": "string",
                        "format": "email",
                        "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": ["settings"]
      }
