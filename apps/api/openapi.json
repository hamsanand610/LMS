{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/settings": {
      "get": {
        "operationId": "SettingsController_getAll",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": ["settings"]
      },
      "patch": {
        "operationId": "SettingsController_update",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "general": {
                    "type": "object",
                    "properties": {
                      "instituteName": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      },
                      "contactEmail": {
                        "default": null,
                        "nullable": true,
                        "type": "string",
                        "format": "email",
                        "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                      },
                      "contactPhone": {
                        "default": null,
                        "nullable": true,
                        "type": "string",
                        "maxLength": 20
                      },
                      "timezone": {
                        "default": "Asia/Kolkata",
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      },
                      "locale": {
                        "default": "en-IN",
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 10
                      }
                    }
                  },
                  "academic": {
                    "type": "object",
                    "properties": {
                      "attendanceThresholdPct": {
                        "default": 75,
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 100
                      },
                      "attendanceCountedStatuses": {
                        "default": ["present", "late", "excused"],
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": ["present", "late", "excused"]
                        }
                      },
                      "attendanceCorrectionWindowHours": {
                        "default": 48,
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 720
                      },
                      "lessonAutoCompletePct": {
                        "default": 90,
                        "type": "integer",
                        "minimum": 50,
                        "maximum": 100
                      },
                      "defaultAssignmentAttempts": {
                        "default": 3,
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 100
                      },
                      "defaultNegativeMarkingFraction": {
                        "default": 0,
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "autoReleaseResults": {
                        "default": false,
                        "type": "boolean"
                      }
                    }
                  },
                  "legal": {
                    "type": "object",
                    "properties": {
                      "termsPageSlug": {
                        "default": "terms",
                        "type": "string",
                        "maxLength": 64
                      },
                      "privacyPageSlug": {
                        "default": "privacy",
                        "type": "string",
                        "maxLength": 64
                      },
                      "consentText": {
                        "default": "I agree to the terms of use and the privacy notice of this institute.",
                        "type": "string",
                        "maxLength": 500
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": ["settings"]
      }
    },
