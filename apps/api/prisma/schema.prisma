// LMS platform — Phase 1 (Foundation) schema.
// Conventions: UUID v7 ids, snake_case columns/tables via @map, timestamptz in UTC,
// explicit status enums, soft delete (deleted_at) on user-facing entities.
// Module ownership is noted per model; later phases add their tables with their own migrations.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── enums ─────────────────────────────

enum UserStatus {
  invited
  active
  suspended
  deactivated
}

enum PermissionScope {
  all
  batch
  own
}

enum FlagKind {
  module
  option
}

enum FileStatus {
  pending
  ready
  failed
}

enum FileVisibility {
  private
  public
}

// ───────────────────────── settings (tenant anchor) ─────────────────────────

/// One row per deployment (single-tenant per instance). Everything client-specific hangs off it.
model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  key       String   @unique @db.VarChar(64)
  name      String   @db.VarChar(120)
  timezone  String   @default("Asia/Kolkata") @db.VarChar(64)
  locale    String   @default("en-IN") @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  users             User[]
  roles             Role[]
  settings          Setting[]
  branding          BrandingSettings?
  featureFlags      FeatureFlag[]
  navigationConfigs NavigationConfig[]
  auditLogs         AuditLog[]
  files             File[]
  programs          Program[]
  batches           Batch[]
  announcements     Announcement[]
  customFields      CustomFieldDefinition[]
  importJobs        ImportJob[]
  taxonomyTerms     TaxonomyTerm[]
  courses           Course[]

  @@map("organizations")
}

/// Typed settings sections stored as JSON per key (general, academic, legal, …).
model Setting {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String   @db.VarChar(64)
  value          Json
  updatedById    String?  @map("updated_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, key])
  @@map("settings")
}

/// Branding seeds entered by the client and the tokens derived from them.
model BrandingSettings {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @unique @map("organization_id") @db.Uuid
  seeds          Json
  computedTokens Json     @map("computed_tokens")
  version        Int      @default(1)
  updatedById    String?  @map("updated_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("branding_settings")
}

/// Module and option flags with optional audience (roles / batches).
model FeatureFlag {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String   @db.VarChar(80)
  description    String   @default("") @db.VarChar(240)
  enabled        Boolean
  kind           FlagKind
  locked         Boolean  @default(false)
  audience       Json     @default("{\"roleKeys\":[],\"batchIds\":[]}")
  updatedById    String?  @map("updated_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, key])
  @@map("feature_flags")
}

/// Client overrides of navigation labels/order/visibility, per portal.
model NavigationConfig {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  portal         String   @db.VarChar(20)
  items          Json
  updatedById    String?  @map("updated_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, portal])
  @@map("navigation_config")
}

// ───────────────────────────── users & auth ─────────────────────────────

model User {
  id               String     @id @default(uuid(7)) @db.Uuid
  organizationId   String     @map("organization_id") @db.Uuid
  email            String     @unique @db.VarChar(254)
  mobile           String?    @unique @db.VarChar(20)
  passwordHash     String?    @map("password_hash") @db.VarChar(255)
  name             String     @db.VarChar(120)
  avatarFileId     String?    @map("avatar_file_id") @db.Uuid
  status           UserStatus @default(invited)
  emailVerifiedAt  DateTime?  @map("email_verified_at") @db.Timestamptz
  lastLoginAt      DateTime?  @map("last_login_at") @db.Timestamptz
  failedLoginCount Int        @default(0) @map("failed_login_count")
  lockedUntil      DateTime?  @map("locked_until") @db.Timestamptz
  /// Incremented on password change, role change and logout-all; embedded in tokens to revoke them.
  tokenVersion     Int        @default(0) @map("token_version")
  createdById      String?    @map("created_by_id") @db.Uuid
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime?  @map("deleted_at") @db.Timestamptz

  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  roles                   UserRole[]
  sessions                Session[]
  invitations             Invitation[]
  passwordResets          PasswordReset[]
  studentProfile          StudentProfile?
  trainerProfile          TrainerProfile?
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  authoredNotes           StudentNote[]            @relation("StudentNoteAuthor")
  activityEvents          ActivityEvent[]

  @@index([organizationId, status])
  @@map("users")
}

/// Single-use invitation token (hashed). Accepting it activates the account.
model Invitation {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("invitations")
}

/// Single-use password reset token (hashed).
model PasswordReset {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

/// Refresh-token sessions with rotation (family id) and reuse detection.
model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(128)
  deviceLabel      String?   @map("device_label") @db.VarChar(120)
  ip               String?   @db.VarChar(64)
  userAgent        String?   @map("user_agent") @db.VarChar(400)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

// ───────────────────────────── rbac ─────────────────────────────

model Role {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String   @db.VarChar(64)
  name           String   @db.VarChar(80)
  description    String   @default("") @db.VarChar(240)
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  permissions  RolePermission[]
  users        UserRole[]

  @@unique([organizationId, key])
  @@map("roles")
}

/// Permission catalogue, seeded from module manifests (never edited by clients).
model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique @db.VarChar(80)
  resource    String   @db.VarChar(40)
  action      String   @db.VarChar(40)
  moduleKey   String   @map("module_key") @db.VarChar(40)
  description String   @default("") @db.VarChar(240)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  roles RolePermission[]

  @@index([moduleKey])
  @@map("permissions")
}

model RolePermission {
  roleId       String          @map("role_id") @db.Uuid
  permissionId String          @map("permission_id") @db.Uuid
  scope        PermissionScope @default(all)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId      String   @map("user_id") @db.Uuid
  roleId      String   @map("role_id") @db.Uuid
  grantedById String?  @map("granted_by_id") @db.Uuid
  grantedAt   DateTime @default(now()) @map("granted_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ───────────────────────────── audit ─────────────────────────────

/// Append-only. No updates or deletes are ever issued against this table.
model AuditLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  action         String   @db.VarChar(80)
  resourceType   String   @map("resource_type") @db.VarChar(60)
  resourceId     String?  @map("resource_id") @db.VarChar(64)
  summary        String   @default("") @db.VarChar(240)
  before         Json?
  after          Json?
  ip             String?  @db.VarChar(64)
  userAgent      String?  @map("user_agent") @db.VarChar(400)
  requestId      String?  @map("request_id") @db.VarChar(64)
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([resourceType, resourceId])
  @@index([actorId, occurredAt])
  @@index([occurredAt])
  @@map("audit_logs")
}

// ───────────────────────────── files ─────────────────────────────

/// File registry: every stored object has a row; the object lives in S3-compatible storage.
model File {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  /// Context that owns the file (e.g. branding-logo, avatar, lesson-resource).
  ownerType      String         @map("owner_type") @db.VarChar(40)
  ownerId        String?        @map("owner_id") @db.VarChar(64)
  driver         String         @db.VarChar(20)
  bucket         String         @db.VarChar(120)
  key            String         @db.VarChar(400)
  originalName   String         @map("original_name") @db.VarChar(255)
  mime           String         @db.VarChar(120)
  size           Int
  checksum       String?        @db.VarChar(128)
  visibility     FileVisibility @default(private)
  status         FileStatus     @default(pending)
  uploadedById   String?        @map("uploaded_by_id") @db.Uuid
  retentionUntil DateTime?      @map("retention_until") @db.Timestamptz
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([bucket, key])
  @@index([ownerType, ownerId])
  @@map("files")
}

// ═══════════════════════ Phase 2 — admin foundation ═══════════════════════
// Modules: students, trainers, batches (with programmes), notifications, reports.

enum StudentStatus {
  prospect
  enrolled
  active
  completed
  alumni
  dropped
}

enum VerificationStatus {
  unverified
  pending
  verified
}

enum DocumentStatus {
  pending
  verified
  rejected
}

enum ProgramStatus {
  active
  archived
}

enum BatchStatus {
  planned
  running
  completed
  archived
}

enum BatchMode {
  online
  offline
  hybrid
}

enum AnnouncementStatus {
  scheduled
  active
  expired
}

enum ImportJobStatus {
  queued
  running
  done
  failed
}

// ───────────────────────────── people ─────────────────────────────

/// The learner record behind a user account. Sensitive sections are gated by
/// `students:read_sensitive`; `custom` holds values for client-defined fields.
model StudentProfile {
  id                 String             @id @default(uuid(7)) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  studentCode        String             @unique @map("student_code") @db.VarChar(32)
  status             StudentStatus      @default(enrolled)
  verificationStatus VerificationStatus @default(unverified) @map("verification_status")
  /// Personal details (date of birth, guardian, address). Partially hidden without permission.
  personal           Json               @default("{}")
  /// Array of qualifications, newest first.
  education          Json               @default("[]")
  experience         Json               @default("[]")
  links              Json               @default("{}")
  summary            String             @default("") @db.VarChar(1000)
  skills             String[]           @default([])
  completeness       Int                @default(0)
  custom             Json               @default("{}")
  createdById        String?            @map("created_by_id") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  members        BatchMember[]
  documents      Document[]
  notes          StudentNote[]
  enrollments    Enrollment[]
  lessonProgress LessonProgress[]

  @@index([status])
  @@index([verificationStatus])
  @@map("student_profiles")
}

/// A document a student uploaded, reviewed by staff.
model Document {
  id           String         @id @default(uuid(7)) @db.Uuid
  studentId    String         @map("student_id") @db.Uuid
  type         String         @db.VarChar(40)
  title        String         @default("") @db.VarChar(120)
  fileId       String         @map("file_id") @db.Uuid
  status       DocumentStatus @default(pending)
  reason       String         @default("") @db.VarChar(240)
  reviewedById String?        @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?      @map("reviewed_at") @db.Timestamptz
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, type])
  @@index([status])
  @@map("documents")
}

/// Internal staff note about a student; never visible to the student.
model StudentNote {
  id        String   @id @default(uuid(7)) @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  text      String   @db.VarChar(2000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  author  User           @relation("StudentNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([studentId, createdAt])
  @@map("student_notes")
}

/// Teaching staff record behind a user account.
model TrainerProfile {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  subjects  String[] @default([])
  headline  String   @default("") @db.VarChar(120)
  bio       String   @default("") @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user        User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignments BatchTrainer[]
  series      SessionSeries[]
  sessions    LiveSession[]

  @@map("trainer_profiles")
}

// ───────────────────────── programmes and batches ─────────────────────────

/// Curriculum template a batch is created from. Courses attach in Phase 3.
model Program {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  code           String        @unique @db.VarChar(20)
  name           String        @db.VarChar(120)
  durationWeeks  Int           @map("duration_weeks")
  description    String        @default("") @db.VarChar(1000)
  status         ProgramStatus @default(active)
  createdById    String?       @map("created_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  batches      Batch[]

  @@index([organizationId, status])
  @@map("programs")
}

/// A cohort running a programme between two dates.
model Batch {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  programId      String      @map("program_id") @db.Uuid
  code           String      @unique @db.VarChar(30)
  name           String      @db.VarChar(120)
  mode           BatchMode   @default(offline)
  status         BatchStatus @default(planned)
  startDate      DateTime    @map("start_date") @db.Date
  endDate        DateTime    @map("end_date") @db.Date
  capacity       Int         @default(60)
  custom         Json        @default("{}")
  createdById    String?     @map("created_by_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  program      Program         @relation(fields: [programId], references: [id], onDelete: Restrict)
  members      BatchMember[]
  trainers     BatchTrainer[]
  series       SessionSeries[]
  sessions     LiveSession[]

  @@index([status, startDate])
  @@index([programId])
  @@map("batches")
}

/// Membership of a student in a batch. Leaving keeps the row (history) and clears `isActive`.
model BatchMember {
  id        String    @id @default(uuid(7)) @db.Uuid
  batchId   String    @map("batch_id") @db.Uuid
  studentId String    @map("student_id") @db.Uuid
  joinedAt  DateTime  @default(now()) @map("joined_at") @db.Timestamptz
  leftAt    DateTime? @map("left_at") @db.Timestamptz
  reason    String    @default("") @db.VarChar(240)
  isActive  Boolean   @default(true) @map("is_active")
  addedById String?   @map("added_by_id") @db.Uuid

  batch   Batch          @relation(fields: [batchId], references: [id], onDelete: Restrict)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([batchId, studentId, joinedAt])
  @@index([studentId, isActive])
  @@index([batchId, isActive])
  @@map("batch_members")
}

/// Trainer assigned to a batch for one subject.
model BatchTrainer {
  id        String   @id @default(uuid(7)) @db.Uuid
  batchId   String   @map("batch_id") @db.Uuid
  trainerId String   @map("trainer_id") @db.Uuid
  subject   String   @db.VarChar(60)
  role      String   @default("lead") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  batch   Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  trainer TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Restrict)

  @@unique([batchId, trainerId, subject])
  @@index([trainerId])
  @@map("batch_trainers")
}

// ───────────────────── notifications and announcements ─────────────────────

/// One in-app message for one user. Email delivery is a separate queued job.
model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  category  String    @db.VarChar(40)
  type      String    @db.VarChar(60)
  title     String    @db.VarChar(160)
  body      String    @default("") @db.VarChar(2000)
  link      String?   @db.VarChar(300)
  data      Json      @default("{}")
  readAt    DateTime? @map("read_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

/// Per-user channel choice for one category. An absent row means the defaults apply.
model NotificationPreference {
  id       String  @id @default(uuid(7)) @db.Uuid
  userId   String  @map("user_id") @db.Uuid
  category String  @db.VarChar(40)
  inApp    Boolean @default(true) @map("in_app")
  email    Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@map("notification_preferences")
}

/// A broadcast with a validity window. Delivery fans out into notifications when it becomes active.
model Announcement {
  id             String             @id @default(uuid(7)) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  title          String             @db.VarChar(160)
  body           String             @db.VarChar(4000)
  audience       Json               @default("{}")
  channels       String[]           @default(["in_app"])
  startsAt       DateTime           @map("starts_at") @db.Timestamptz
  endsAt         DateTime?          @map("ends_at") @db.Timestamptz
  status         AnnouncementStatus @default(scheduled)
  deliveredAt    DateTime?          @map("delivered_at") @db.Timestamptz
  recipientCount Int                @default(0) @map("recipient_count")
  createdById    String?            @map("created_by_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?          @map("deleted_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([status, startsAt])
  @@map("announcements")
}

// ─────────────────── client-defined fields and imports ───────────────────

/// A field a client adds to an entity without a code change; values live in the entity's `custom`.
model CustomFieldDefinition {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  entityType     String   @map("entity_type") @db.VarChar(40)
  key            String   @db.VarChar(40)
  label          String   @db.VarChar(80)
  type           String   @db.VarChar(20)
  helpText       String   @default("") @map("help_text") @db.VarChar(200)
  options        Json     @default("[]")
  required       Boolean  @default(false)
  visibility     String   @default("staff") @db.VarChar(20)
  position       Int      @default(0)
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, entityType, key])
  @@index([organizationId, entityType, archived])
  @@map("custom_field_definitions")
}

/// Bulk import run (students today; other entities later). Errors are kept for the report.
model ImportJob {
  id             String          @id @default(uuid(7)) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  type           String          @db.VarChar(40)
  status         ImportJobStatus @default(queued)
  filename       String          @default("") @db.VarChar(200)
  dryRun         Boolean         @default(false) @map("dry_run")
  params         Json            @default("{}")
  total          Int             @default(0)
  created        Int             @default(0)
  skipped        Int             @default(0)
  failed         Int             @default(0)
  errors         Json            @default("[]")
  requestedById  String?         @map("requested_by_id") @db.Uuid
  startedAt      DateTime?       @map("started_at") @db.Timestamptz
  finishedAt     DateTime?       @map("finished_at") @db.Timestamptz
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, type, createdAt])
  @@map("import_jobs")
}

// ═══════════════════════ Phase 3 — learning foundation ═══════════════════════
// Modules: courses (content and publication), progress (enrolment and completion), sessions.

enum CourseStatus {
  draft
  published
  archived
}

enum LessonType {
  video
  article
  resources
  practice
}

enum CompletionRule {
  watch
  view
  manual
}

enum PublicationScope {
  all
  program
  batch
}

enum EnrollmentStatus {
  active
  completed
}

enum LessonProgressStatus {
  not_started
  in_progress
  completed
}

enum SessionStatus {
  scheduled
  live
  completed
  cancelled
}

enum SeriesStatus {
  active
  ended
}

// ───────────────────────── taxonomies ─────────────────────────

/// Curated vocabularies (course levels, subjects, topics). Records reference a term by its key,
/// so renaming the label never breaks them. The vocabularies themselves are fixed in code.
model TaxonomyTerm {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  taxonomy       String   @db.VarChar(40)
  key            String   @db.VarChar(40)
  label          String   @db.VarChar(80)
  position       Int      @default(0)
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, taxonomy, key])
  @@index([organizationId, taxonomy, archived])
  @@map("taxonomy_terms")
}

// ───────────────────────── courses ─────────────────────────

/// A course is the unit that gets published to a programme or a batch.
model Course {
  id               String       @id @default(uuid(7)) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  slug             String       @unique @db.VarChar(140)
  title            String       @db.VarChar(120)
  description      String       @default("") @db.VarChar(2000)
  /// Taxonomy term keys, not labels.
  level            String       @default("") @db.VarChar(40)
  subject          String       @default("") @db.VarChar(60)
  tags             String[]     @default([])
  thumbnailFileId  String?      @map("thumbnail_file_id") @db.Uuid
  estimatedMinutes Int          @default(0) @map("estimated_minutes")
  status           CourseStatus @default(draft)
  /// Incremented on every outline save, so a publication can name what learners received.
  version          Int          @default(1)
  ownerId          String?      @map("owner_id") @db.Uuid
  createdById      String?      @map("created_by_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  modules      CourseModule[]
  publications CoursePublication[]
  enrollments  Enrollment[]

  @@index([organizationId, status])
  @@index([subject])
  @@map("courses")
}

/// An ordered group of lessons inside a course.
model CourseModule {
  id         String   @id @default(uuid(7)) @db.Uuid
  courseId   String   @map("course_id") @db.Uuid
  title      String   @db.VarChar(160)
  position   Int
  /// { type: "always" } or { type: "after_previous", minPercent: n }
  unlockRule Json     @default("{\"type\":\"always\"}") @map("unlock_rule")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([courseId, position])
  @@map("course_modules")
}

/// One thing a learner does: watch, read, download or practise.
model Lesson {
  id              String         @id @default(uuid(7)) @db.Uuid
  moduleId        String         @map("module_id") @db.Uuid
  title           String         @db.VarChar(160)
  type            LessonType
  position        Int
  durationSeconds Int            @default(0) @map("duration_seconds")
  /// { html, video: { driver, key, durationSeconds } | null, questionId | null }
  content         Json           @default("{}")
  completionRule  CompletionRule @default(manual) @map("completion_rule")
  isMandatory     Boolean        @default(true) @map("is_mandatory")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  module    CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  resources LessonResource[]
  progress  LessonProgress[]
  sessions  LiveSession[]

  @@unique([moduleId, position])
  @@index([type])
  @@map("lessons")
}

/// A downloadable file or link attached to a lesson.
model LessonResource {
  id       String  @id @default(uuid(7)) @db.Uuid
  lessonId String  @map("lesson_id") @db.Uuid
  title    String  @db.VarChar(120)
  fileId   String? @map("file_id") @db.Uuid
  url      String  @default("") @db.VarChar(500)
  position Int     @default(0)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("lesson_resources")
}

/// Who a course has been published to. One live publication per scope; unpublishing ends it.
model CoursePublication {
  id            String           @id @default(uuid(7)) @db.Uuid
  courseId      String           @map("course_id") @db.Uuid
  scopeType     PublicationScope @map("scope_type")
  scopeId       String?          @map("scope_id") @db.Uuid
  version       Int              @default(1)
  note          String           @default("") @db.VarChar(240)
  publishedById String?          @map("published_by_id") @db.Uuid
  publishedAt   DateTime         @default(now()) @map("published_at") @db.Timestamptz
  unpublishedAt DateTime?        @map("unpublished_at") @db.Timestamptz

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, unpublishedAt])
  @@index([scopeType, scopeId])
  @@map("course_publications")
}

// ───────────────────────── progress ─────────────────────────

/// Derived from publications: one row per student per course they can reach.
model Enrollment {
  id             String           @id @default(uuid(7)) @db.Uuid
  studentId      String           @map("student_id") @db.Uuid
  courseId       String           @map("course_id") @db.Uuid
  /// Which publication brought them in (programme, batch or the whole institute).
  source         String           @default("publication") @db.VarChar(40)
  status         EnrollmentStatus @default(active)
  progressPct    Int              @default(0) @map("progress_pct")
  enrolledAt     DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz
  completedAt    DateTime?        @map("completed_at") @db.Timestamptz
  lastAccessedAt DateTime?        @map("last_accessed_at") @db.Timestamptz

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([courseId, status])
  @@map("enrollments")
}

/// How far one learner got in one lesson.
model LessonProgress {
  id              String               @id @default(uuid(7)) @db.Uuid
  studentId       String               @map("student_id") @db.Uuid
  lessonId        String               @map("lesson_id") @db.Uuid
  status          LessonProgressStatus @default(not_started)
  positionSeconds Int                  @default(0) @map("position_seconds")
  watchedPct      Int                  @default(0) @map("watched_pct")
  completedAt     DateTime?            @map("completed_at") @db.Timestamptz
  lastAccessedAt  DateTime             @default(now()) @map("last_accessed_at") @db.Timestamptz

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@index([studentId, lastAccessedAt])
  @@map("lesson_progress")
}

/// Append-only feed of what a person did, for the activity list and later analytics.
model ActivityEvent {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  type           String   @db.VarChar(60)
  entityType     String   @default("") @map("entity_type") @db.VarChar(40)
  entityId       String?  @map("entity_id") @db.Uuid
  title          String   @default("") @db.VarChar(200)
  link           String?  @db.VarChar(300)
  payload        Json     @default("{}")
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz
  idempotencyKey String?  @unique @map("idempotency_key") @db.VarChar(120)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@map("activity_events")
}

// ───────────────────────── schedule ─────────────────────────

/// A repeating class: the same subject, days and times over a date range.
model SessionSeries {
  id          String       @id @default(uuid(7)) @db.Uuid
  batchId     String       @map("batch_id") @db.Uuid
  subject     String       @db.VarChar(60)
  title       String       @default("") @db.VarChar(160)
  trainerId   String?      @map("trainer_id") @db.Uuid
  weekdays    String[]     @default([])
  startsTime  String       @map("starts_time") @db.VarChar(5)
  endsTime    String       @map("ends_time") @db.VarChar(5)
  fromDate    DateTime     @map("from_date") @db.Date
  untilDate   DateTime     @map("until_date") @db.Date
  joinUrl     String       @default("") @map("join_url") @db.VarChar(500)
  provider    String       @default("none") @db.VarChar(20)
  skipDates   String[]     @default([]) @map("skip_dates")
  status      SeriesStatus @default(active)
  createdById String?      @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  batch    Batch           @relation(fields: [batchId], references: [id], onDelete: Cascade)
  trainer  TrainerProfile? @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  sessions LiveSession[]

  @@index([batchId, status])
  @@map("session_series")
}

/// One class at one time. Generated from a series, or created on its own.
model LiveSession {
  id                String        @id @default(uuid(7)) @db.Uuid
  seriesId          String?       @map("series_id") @db.Uuid
  batchId           String        @map("batch_id") @db.Uuid
  trainerId         String?       @map("trainer_id") @db.Uuid
  subject           String        @db.VarChar(60)
  title             String        @default("") @db.VarChar(160)
  startsAt          DateTime      @map("starts_at") @db.Timestamptz
  endsAt            DateTime      @map("ends_at") @db.Timestamptz
  joinUrl           String        @default("") @map("join_url") @db.VarChar(500)
  provider          String        @default("none") @db.VarChar(20)
  status            SessionStatus @default(scheduled)
  notes             String        @default("") @db.VarChar(1000)
  recordingLessonId String?       @map("recording_lesson_id") @db.Uuid
  /// Set once the "starting soon" reminder has gone out, so it is never sent twice.
  reminderSentAt    DateTime?     @map("reminder_sent_at") @db.Timestamptz
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  series          SessionSeries?  @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  batch           Batch           @relation(fields: [batchId], references: [id], onDelete: Cascade)
  trainer         TrainerProfile? @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  recordingLesson Lesson?         @relation(fields: [recordingLessonId], references: [id], onDelete: SetNull)

  @@index([batchId, startsAt])
  @@index([trainerId, startsAt])
  @@index([status, startsAt])
  @@map("live_sessions")
}
