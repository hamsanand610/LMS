// LMS platform — Phase 1 (Foundation) schema.
// Conventions: UUID v7 ids, snake_case columns/tables via @map, timestamptz in UTC,
// explicit status enums, soft delete (deleted_at) on user-facing entities.
// Module ownership is noted per model; later phases add their tables with their own migrations.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
  // Partial unique indexes (Phase 5): one live publication per course and audience.
  previewFeatures        = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── enums ─────────────────────────────

enum UserStatus {
  invited
  active
  suspended
  deactivated
}

enum PermissionScope {
  all
  batch
  own
}

enum FlagKind {
  module
  option
}

enum FileStatus {
  pending
  ready
  failed
}

enum FileVisibility {
  private
  public
}

// ───────────────────────── settings (tenant anchor) ─────────────────────────

/// One row per deployment (single-tenant per instance). Everything client-specific hangs off it.
model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  key       String   @unique @db.VarChar(64)
  name      String   @db.VarChar(120)
  timezone  String   @default("Asia/Kolkata") @db.VarChar(64)
  locale    String   @default("en-IN") @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  users             User[]
  roles             Role[]
  settings          Setting[]
  branding          BrandingSettings?
  featureFlags      FeatureFlag[]
  navigationConfigs NavigationConfig[]
  auditLogs         AuditLog[]
  files             File[]
  programs          Program[]
  batches           Batch[]
  announcements     Announcement[]
  customFields      CustomFieldDefinition[]
  importJobs        ImportJob[]
  taxonomyTerms     TaxonomyTerm[]
  courses           Course[]
  questions         Question[]
  assignments       Assignment[]
  tests             Test[]
  reportExports     ReportExport[]
  certificates      Certificate[]
  contentPages      ContentPage[]
  emailTemplates    EmailTemplate[]
  integrations      IntegrationConfig[]
  companies         Company[]
  placementDrives   PlacementDrive[]
  doubts            Doubt[]
  feedbackForms     FeedbackForm[]
  aiConversations   AiConversation[]
  aiRequests        AiRequest[]
  aiUsage           AiUsageDaily[]
  aiCacheEntries    AiCacheEntry[]
  knowledgeSources  KnowledgeSource[]

  @@map("organizations")
}

/// Typed settings sections stored as JSON per key (general, academic, legal, …).
model Setting {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String   @db.VarChar(64)
  value          Json
  updatedById    String?  @map("updated_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, key])
  @@map("settings")
}

/// Branding seeds entered by the client and the tokens derived from them.
model BrandingSettings {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @unique @map("organization_id") @db.Uuid
  seeds          Json
  computedTokens Json     @map("computed_tokens")
  version        Int      @default(1)
  updatedById    String?  @map("updated_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("branding_settings")
}

/// Module and option flags with optional audience (roles / batches).
model FeatureFlag {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String   @db.VarChar(80)
  description    String   @default("") @db.VarChar(240)
  enabled        Boolean
  kind           FlagKind
  locked         Boolean  @default(false)
  audience       Json     @default("{\"roleKeys\":[],\"batchIds\":[]}")
  updatedById    String?  @map("updated_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, key])
  @@map("feature_flags")
}

/// Client overrides of navigation labels/order/visibility, per portal.
model NavigationConfig {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  portal         String   @db.VarChar(20)
  items          Json
  updatedById    String?  @map("updated_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, portal])
  @@map("navigation_config")
}

// ───────────────────────────── users & auth ─────────────────────────────

model User {
  id               String     @id @default(uuid(7)) @db.Uuid
  organizationId   String     @map("organization_id") @db.Uuid
  email            String     @unique @db.VarChar(254)
  mobile           String?    @unique @db.VarChar(20)
  passwordHash     String?    @map("password_hash") @db.VarChar(255)
  name             String     @db.VarChar(120)
  avatarFileId     String?    @map("avatar_file_id") @db.Uuid
  status           UserStatus @default(invited)
  emailVerifiedAt  DateTime?  @map("email_verified_at") @db.Timestamptz
  lastLoginAt      DateTime?  @map("last_login_at") @db.Timestamptz
  failedLoginCount Int        @default(0) @map("failed_login_count")
  lockedUntil      DateTime?  @map("locked_until") @db.Timestamptz
  /// Incremented on password change, role change and logout-all; embedded in tokens to revoke them.
  tokenVersion     Int        @default(0) @map("token_version")
  createdById      String?    @map("created_by_id") @db.Uuid
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime?  @map("deleted_at") @db.Timestamptz

  organization            Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  roles                   UserRole[]
  sessions                Session[]
  invitations             Invitation[]
  passwordResets          PasswordReset[]
  studentProfile          StudentProfile?
  trainerProfile          TrainerProfile?
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  authoredNotes           StudentNote[]               @relation("StudentNoteAuthor")
  activityEvents          ActivityEvent[]
  authoredQuestions       Question[]                  @relation("QuestionAuthor")
  executionRuns           ExecutionRun[]              @relation("ExecutionRunUser")
  labDrafts               LabDraft[]
  attendanceMarked        AttendanceRecord[]          @relation("AttendanceMarkedBy")
  attendanceCorrected     AttendanceRecord[]          @relation("AttendanceCorrectedBy")
  markedSessions          LiveSession[]               @relation("SessionAttendanceMarkedBy")
  reportExports           ReportExport[]
  companyFavourites       CompanyFavourite[]
  doubtReplies            DoubtReply[]
  submissionReviews       SubmissionReview[]          @relation("SubmissionReviewer")
  aiConversations         AiConversation[]
  aiMessages              AiMessage[]
  aiRequests              AiRequest[]
  aiUsage                 AiUsageDaily[]
  aiCacheEntries          AiCacheEntry[]
  knowledgeSources        KnowledgeSource[]           @relation("KnowledgeSourceCreator")
  knowledgeDocuments      KnowledgeDocument[]         @relation("KnowledgeDocumentCreator")
  knowledgeVersions       KnowledgeDocumentVersion[]  @relation("KnowledgeVersionCreator")
  knowledgeEmbeddings     KnowledgeVersionEmbedding[] @relation("KnowledgeEmbeddingRequester")

  @@index([organizationId, status])
  @@map("users")
}

/// Single-use invitation token (hashed). Accepting it activates the account.
model Invitation {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("invitations")
}

/// Single-use password reset token (hashed).
model PasswordReset {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

/// Refresh-token sessions with rotation (family id) and reuse detection.
model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(128)
  deviceLabel      String?   @map("device_label") @db.VarChar(120)
  ip               String?   @db.VarChar(64)
  userAgent        String?   @map("user_agent") @db.VarChar(400)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  /// Whether the sign-in asked to be remembered: a refresh keeps the cookies as the sign-in set
  /// them, outliving the browser or not (Phase 6).
  persistent       Boolean   @default(true)
  /// When a refresh replaced this session with the next of its family. Set with revokedAt by a
  /// rotation only: a session revoked without it was signed out, and its family has ended
  /// (Phase 6).
  rotatedAt        DateTime? @map("rotated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

// ───────────────────────────── rbac ─────────────────────────────

model Role {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String   @db.VarChar(64)
  name           String   @db.VarChar(80)
  description    String   @default("") @db.VarChar(240)
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  permissions  RolePermission[]
  users        UserRole[]

  @@unique([organizationId, key])
  @@map("roles")
}

/// Permission catalogue, seeded from module manifests (never edited by clients).
model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique @db.VarChar(80)
  resource    String   @db.VarChar(40)
  action      String   @db.VarChar(40)
  moduleKey   String   @map("module_key") @db.VarChar(40)
  description String   @default("") @db.VarChar(240)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  roles RolePermission[]

  @@index([moduleKey])
  @@map("permissions")
}

model RolePermission {
  roleId       String          @map("role_id") @db.Uuid
  permissionId String          @map("permission_id") @db.Uuid
  scope        PermissionScope @default(all)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId      String   @map("user_id") @db.Uuid
  roleId      String   @map("role_id") @db.Uuid
  grantedById String?  @map("granted_by_id") @db.Uuid
  grantedAt   DateTime @default(now()) @map("granted_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ───────────────────────────── audit ─────────────────────────────

/// Append-only. No updates or deletes are ever issued against this table.
model AuditLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  action         String   @db.VarChar(80)
  resourceType   String   @map("resource_type") @db.VarChar(60)
  resourceId     String?  @map("resource_id") @db.VarChar(64)
  summary        String   @default("") @db.VarChar(240)
  before         Json?
  after          Json?
  ip             String?  @db.VarChar(64)
  userAgent      String?  @map("user_agent") @db.VarChar(400)
  requestId      String?  @map("request_id") @db.VarChar(64)
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([resourceType, resourceId])
  @@index([actorId, occurredAt])
  @@index([occurredAt])
  @@map("audit_logs")
}

// ───────────────────────────── files ─────────────────────────────

/// File registry: every stored object has a row; the object lives in S3-compatible storage.
model File {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  /// Context that owns the file (e.g. branding-logo, avatar, lesson-resource).
  ownerType      String         @map("owner_type") @db.VarChar(40)
  ownerId        String?        @map("owner_id") @db.VarChar(64)
  driver         String         @db.VarChar(20)
  bucket         String         @db.VarChar(120)
  key            String         @db.VarChar(400)
  originalName   String         @map("original_name") @db.VarChar(255)
  mime           String         @db.VarChar(120)
  size           Int
  checksum       String?        @db.VarChar(128)
  visibility     FileVisibility @default(private)
  status         FileStatus     @default(pending)
  uploadedById   String?        @map("uploaded_by_id") @db.Uuid
  retentionUntil DateTime?      @map("retention_until") @db.Timestamptz
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  organization     Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  knowledgeVersion KnowledgeDocumentVersion?

  @@unique([bucket, key])
  @@index([ownerType, ownerId])
  @@map("files")
}

// ═══════════════════════ Phase 2 — admin foundation ═══════════════════════
// Modules: students, trainers, batches (with programmes), notifications, reports.

enum StudentStatus {
  prospect
  enrolled
  active
  completed
  alumni
  dropped
}

enum VerificationStatus {
  unverified
  pending
  verified
}

enum DocumentStatus {
  pending
  verified
  rejected
}

enum ProgramStatus {
  active
  archived
}

enum BatchStatus {
  planned
  running
  completed
  archived
}

enum BatchMode {
  online
  offline
  hybrid
}

enum AnnouncementStatus {
  scheduled
  active
  expired
}

enum ImportJobStatus {
  queued
  running
  done
  failed
}

// ───────────────────────────── people ─────────────────────────────

/// The learner record behind a user account. Sensitive sections are gated by
/// `students:read_sensitive`; `custom` holds values for client-defined fields.
model StudentProfile {
  id                 String             @id @default(uuid(7)) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  studentCode        String             @unique @map("student_code") @db.VarChar(32)
  status             StudentStatus      @default(enrolled)
  verificationStatus VerificationStatus @default(unverified) @map("verification_status")
  /// Personal details (date of birth, guardian, address). Partially hidden without permission.
  personal           Json               @default("{}")
  /// Array of qualifications, newest first.
  education          Json               @default("[]")
  experience         Json               @default("[]")
  links              Json               @default("{}")
  summary            String             @default("") @db.VarChar(1000)
  skills             String[]           @default([])
  completeness       Int                @default(0)
  custom             Json               @default("{}")
  /// Array of { title, description, link, technologies[] } the learner added (Task 2).
  projects           Json               @default("[]")
  /// Array of { title, issuer, year, link } the learner added; none are issued by the platform.
  certifications     Json               @default("[]")
  createdById        String?            @map("created_by_id") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  members                BatchMember[]
  documents              Document[]
  notes                  StudentNote[]
  enrollments            Enrollment[]
  lessonProgress         LessonProgress[]
  submissions            Submission[]
  testAttempts           TestAttempt[]
  attendance             AttendanceRecord[]
  resumes                Resume[]
  applications           DriveApplication[]
  doubts                 Doubt[]
  /// Assignments given to this learner personally rather than through a batch.
  assignmentPublications AssignmentPublication[]
  certificates           Certificate[]
  feedbackResponses      FeedbackResponse[]

  @@index([status])
  @@index([verificationStatus])
  @@map("student_profiles")
}

/// A document a student uploaded, reviewed by staff.
model Document {
  id           String         @id @default(uuid(7)) @db.Uuid
  studentId    String         @map("student_id") @db.Uuid
  type         String         @db.VarChar(40)
  title        String         @default("") @db.VarChar(120)
  fileId       String         @map("file_id") @db.Uuid
  status       DocumentStatus @default(pending)
  reason       String         @default("") @db.VarChar(240)
  reviewedById String?        @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?      @map("reviewed_at") @db.Timestamptz
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, type])
  @@index([status])
  @@map("documents")
}

/// Internal staff note about a student; never visible to the student.
model StudentNote {
  id        String   @id @default(uuid(7)) @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  text      String   @db.VarChar(2000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  author  User           @relation("StudentNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([studentId, createdAt])
  @@map("student_notes")
}

/// Teaching staff record behind a user account.
model TrainerProfile {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  subjects  String[] @default([])
  headline  String   @default("") @db.VarChar(120)
  bio       String   @default("") @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user        User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignments BatchTrainer[]
  series      SessionSeries[]
  sessions    LiveSession[]
  courseStaff CourseStaff[]
  feedback    FeedbackForm[]

  @@map("trainer_profiles")
}

// ───────────────────────── programmes and batches ─────────────────────────

/// Curriculum template a batch is created from. Courses attach in Phase 3.
model Program {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  code           String        @unique @db.VarChar(20)
  name           String        @db.VarChar(120)
  durationWeeks  Int           @map("duration_weeks")
  description    String        @default("") @db.VarChar(1000)
  status         ProgramStatus @default(active)
  createdById    String?       @map("created_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  batches      Batch[]
  assignments  Assignment[]

  @@index([organizationId, status])
  @@map("programs")
}

/// A cohort running a programme between two dates.
model Batch {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  programId      String      @map("program_id") @db.Uuid
  code           String      @unique @db.VarChar(30)
  name           String      @db.VarChar(120)
  mode           BatchMode   @default(offline)
  status         BatchStatus @default(planned)
  startDate      DateTime    @map("start_date") @db.Date
  endDate        DateTime    @map("end_date") @db.Date
  capacity       Int         @default(60)
  custom         Json        @default("{}")
  createdById    String?     @map("created_by_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  program                Program                 @relation(fields: [programId], references: [id], onDelete: Restrict)
  members                BatchMember[]
  trainers               BatchTrainer[]
  series                 SessionSeries[]
  sessions               LiveSession[]
  assignmentPublications AssignmentPublication[]
  testSchedules          TestSchedule[]
  attendance             AttendanceRecord[]
  feedbackForms          FeedbackForm[]

  @@index([status, startDate])
  @@index([programId])
  @@map("batches")
}

/// Membership of a student in a batch. Leaving keeps the row (history) and clears `isActive`.
model BatchMember {
  id        String    @id @default(uuid(7)) @db.Uuid
  batchId   String    @map("batch_id") @db.Uuid
  studentId String    @map("student_id") @db.Uuid
  joinedAt  DateTime  @default(now()) @map("joined_at") @db.Timestamptz
  leftAt    DateTime? @map("left_at") @db.Timestamptz
  reason    String    @default("") @db.VarChar(240)
  isActive  Boolean   @default(true) @map("is_active")
  addedById String?   @map("added_by_id") @db.Uuid

  batch   Batch          @relation(fields: [batchId], references: [id], onDelete: Restrict)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([batchId, studentId, joinedAt])
  @@index([studentId, isActive])
  @@index([batchId, isActive])
  @@map("batch_members")
}

/// Trainer assigned to a batch for one subject.
model BatchTrainer {
  id        String   @id @default(uuid(7)) @db.Uuid
  batchId   String   @map("batch_id") @db.Uuid
  trainerId String   @map("trainer_id") @db.Uuid
  subject   String   @db.VarChar(60)
  role      String   @default("lead") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  batch   Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  trainer TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Restrict)

  @@unique([batchId, trainerId, subject])
  @@index([trainerId])
  @@map("batch_trainers")
}

// ───────────────────── notifications and announcements ─────────────────────

/// One in-app message for one user. Email delivery is a separate queued job.
model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  category  String    @db.VarChar(40)
  type      String    @db.VarChar(60)
  title     String    @db.VarChar(160)
  body      String    @default("") @db.VarChar(2000)
  link      String?   @db.VarChar(300)
  data      Json      @default("{}")
  readAt    DateTime? @map("read_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  /// Set on notices a job may raise more than once (an overdue assignment, a reconciled certificate):
  /// the same key reaches a person once, however often the job runs (Phase 5).
  dedupeKey String?   @map("dedupe_key") @db.VarChar(160)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

/// Per-user channel choice for one category. An absent row means the defaults apply.
model NotificationPreference {
  id       String  @id @default(uuid(7)) @db.Uuid
  userId   String  @map("user_id") @db.Uuid
  category String  @db.VarChar(40)
  inApp    Boolean @default(true) @map("in_app")
  email    Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@map("notification_preferences")
}

/// A broadcast with a validity window. Delivery fans out into notifications when it becomes active.
model Announcement {
  id             String             @id @default(uuid(7)) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  title          String             @db.VarChar(160)
  body           String             @db.VarChar(4000)
  audience       Json               @default("{}")
  channels       String[]           @default(["in_app"])
  startsAt       DateTime           @map("starts_at") @db.Timestamptz
  endsAt         DateTime?          @map("ends_at") @db.Timestamptz
  status         AnnouncementStatus @default(scheduled)
  deliveredAt    DateTime?          @map("delivered_at") @db.Timestamptz
  recipientCount Int                @default(0) @map("recipient_count")
  createdById    String?            @map("created_by_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?          @map("deleted_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([status, startsAt])
  @@map("announcements")
}

// ─────────────────── client-defined fields and imports ───────────────────

/// A field a client adds to an entity without a code change; values live in the entity's `custom`.
model CustomFieldDefinition {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  entityType     String   @map("entity_type") @db.VarChar(40)
  key            String   @db.VarChar(40)
  label          String   @db.VarChar(80)
  type           String   @db.VarChar(20)
  helpText       String   @default("") @map("help_text") @db.VarChar(200)
  options        Json     @default("[]")
  required       Boolean  @default(false)
  visibility     String   @default("staff") @db.VarChar(20)
  position       Int      @default(0)
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, entityType, key])
  @@index([organizationId, entityType, archived])
  @@map("custom_field_definitions")
}

/// Bulk import run (students today; other entities later). Errors are kept for the report.
model ImportJob {
  id             String          @id @default(uuid(7)) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  type           String          @db.VarChar(40)
  status         ImportJobStatus @default(queued)
  filename       String          @default("") @db.VarChar(200)
  dryRun         Boolean         @default(false) @map("dry_run")
  params         Json            @default("{}")
  total          Int             @default(0)
  created        Int             @default(0)
  skipped        Int             @default(0)
  failed         Int             @default(0)
  errors         Json            @default("[]")
  requestedById  String?         @map("requested_by_id") @db.Uuid
  startedAt      DateTime?       @map("started_at") @db.Timestamptz
  finishedAt     DateTime?       @map("finished_at") @db.Timestamptz
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, type, createdAt])
  @@map("import_jobs")
}

// ═══════════════════════ Phase 3 — learning foundation ═══════════════════════
// Modules: courses (content and publication), progress (enrolment and completion), sessions.

enum CourseStatus {
  draft
  published
  archived
}

enum LessonType {
  video
  article
  resources
  practice
  /// Opens a lab: a coding, SQL, debugging or web exercise run in the sandbox (ADR-0018).
  lab
}

enum CompletionRule {
  watch
  view
  manual
  /// Completes when a submission passes every case in the sandbox (lab lessons).
  pass
}

enum PublicationScope {
  all
  program
  batch
  /// One learner, enrolled on their own (Phases 3–4, D8); the scope id is their student id.
  learner
}

enum EnrollmentStatus {
  active
  completed
  /// The learner left every batch the course reaches them through: access ends, the record stays.
  withdrawn
}

enum LessonProgressStatus {
  not_started
  in_progress
  completed
}

enum SessionStatus {
  scheduled
  live
  completed
  cancelled
}

enum SeriesStatus {
  active
  ended
}

// ───────────────────────── taxonomies ─────────────────────────

/// Curated vocabularies (course levels, subjects, topics). Records reference a term by its key,
/// so renaming the label never breaks them. The vocabularies themselves are fixed in code.
model TaxonomyTerm {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  taxonomy       String   @db.VarChar(40)
  key            String   @db.VarChar(40)
  label          String   @db.VarChar(80)
  position       Int      @default(0)
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, taxonomy, key])
  @@index([organizationId, taxonomy, archived])
  @@map("taxonomy_terms")
}

// ───────────────────────── courses ─────────────────────────

/// A course is the unit that gets published to a programme or a batch.
model Course {
  id               String       @id @default(uuid(7)) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  slug             String       @unique @db.VarChar(140)
  title            String       @db.VarChar(120)
  description      String       @default("") @db.VarChar(2000)
  /// Taxonomy term keys, not labels.
  level            String       @default("") @db.VarChar(40)
  subject          String       @default("") @db.VarChar(60)
  tags             String[]     @default([])
  thumbnailFileId  String?      @map("thumbnail_file_id") @db.Uuid
  estimatedMinutes Int          @default(0) @map("estimated_minutes")
  status           CourseStatus @default(draft)
  /// Incremented on every outline save, so a publication can name what learners received.
  version          Int          @default(1)
  ownerId          String?      @map("owner_id") @db.Uuid
  createdById      String?      @map("created_by_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  modules         CourseModule[]
  publications    CoursePublication[]
  enrollments     Enrollment[]
  doubts          Doubt[]
  assignments     Assignment[]
  certificates    Certificate[]
  staff           CourseStaff[]
  feedback        FeedbackForm[]
  aiConversations AiConversation[]
  knowledge       KnowledgeSource[]

  @@index([organizationId, status])
  @@index([subject])
  @@map("courses")
}

enum CertificateStatus {
  issued
  revoked
}

/// A certificate of course completion (ADR-0022). Written once, when the course is completed, and
/// never recomputed from progress: the names, title and date are a snapshot, so a later edit to the
/// course or the profile cannot change what was certified.
model Certificate {
  id             String            @id @default(uuid(7)) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  studentId      String            @map("student_id") @db.Uuid
  courseId       String            @map("course_id") @db.Uuid
  /// The public verification code: 12 characters of Crockford base32.
  code           String            @unique @db.VarChar(16)
  learnerName    String            @map("learner_name") @db.VarChar(160)
  courseTitle    String            @map("course_title") @db.VarChar(200)
  institute      String            @db.VarChar(160)
  completedAt    DateTime          @map("completed_at") @db.Timestamptz
  issuedAt       DateTime          @default(now()) @map("issued_at") @db.Timestamptz
  status         CertificateStatus @default(issued)
  revokedAt      DateTime?         @map("revoked_at") @db.Timestamptz
  revokedReason  String            @default("") @map("revoked_reason") @db.VarChar(500)
  /// The PDF in private storage; empty until it has been drawn.
  objectKey      String            @default("") @map("object_key") @db.VarChar(400)
  /// Who signs it, as the settings named them when it was issued (Phases 3–4, ADM-13).
  signatoryName  String            @default("") @map("signatory_name") @db.VarChar(80)
  signatoryTitle String            @default("") @map("signatory_title") @db.VarChar(80)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course       Course         @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([studentId, courseId])
  @@index([organizationId, issuedAt])
  @@map("certificates")
}

/// An ordered group of lessons inside a course.
model CourseModule {
  id         String   @id @default(uuid(7)) @db.Uuid
  courseId   String   @map("course_id") @db.Uuid
  title      String   @db.VarChar(160)
  position   Int
  /// { type: "always" } or { type: "after_previous", minPercent: n }
  unlockRule Json     @default("{\"type\":\"always\"}") @map("unlock_rule")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  course            Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons           Lesson[]
  assignmentModules AssignmentModule[]

  @@unique([courseId, position])
  @@map("course_modules")
}

/// One thing a learner does: watch, read, download or practise.
model Lesson {
  id              String         @id @default(uuid(7)) @db.Uuid
  moduleId        String         @map("module_id") @db.Uuid
  title           String         @db.VarChar(160)
  type            LessonType
  position        Int
  durationSeconds Int            @default(0) @map("duration_seconds")
  /// { html, video: { driver, key, durationSeconds } | null, questionId | null }
  content         Json           @default("{}")
  completionRule  CompletionRule @default(manual) @map("completion_rule")
  isMandatory     Boolean        @default(true) @map("is_mandatory")
  /// A label grouping lessons inside a module (Task 2). A label, not a table, so grouping never
  /// changes a lesson id, a completion or an enrolment.
  topic           String         @default("") @db.VarChar(80)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  module          CourseModule        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  resources       LessonResource[]
  progress        LessonProgress[]
  sessions        LiveSession[]
  doubts          Doubt[]
  aiConversations AiConversation[]
  knowledge       KnowledgeDocument[]

  @@unique([moduleId, position])
  @@index([type])
  @@map("lessons")
}

/// A downloadable file or link attached to a lesson.
model LessonResource {
  id       String  @id @default(uuid(7)) @db.Uuid
  lessonId String  @map("lesson_id") @db.Uuid
  title    String  @db.VarChar(120)
  fileId   String? @map("file_id") @db.Uuid
  url      String  @default("") @db.VarChar(500)
  position Int     @default(0)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("lesson_resources")
}

/// Who a course has been published to. One live publication per scope; unpublishing ends it.
model CoursePublication {
  id            String           @id @default(uuid(7)) @db.Uuid
  courseId      String           @map("course_id") @db.Uuid
  scopeType     PublicationScope @map("scope_type")
  scopeId       String?          @map("scope_id") @db.Uuid
  version       Int              @default(1)
  note          String           @default("") @db.VarChar(240)
  publishedById String?          @map("published_by_id") @db.Uuid
  publishedAt   DateTime         @default(now()) @map("published_at") @db.Timestamptz
  unpublishedAt DateTime?        @map("unpublished_at") @db.Timestamptz

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  /// One live publication per course and audience, however many publish requests race (Phase 5).
  /// Everyone (`all`) has no scope id, and PostgreSQL never treats NULLs as equal, hence two indexes.
  @@unique([courseId, scopeType, scopeId], map: "course_publications_live_scope_key", where: raw("unpublished_at IS NULL AND scope_id IS NOT NULL"))
  @@unique([courseId, scopeType], map: "course_publications_live_everyone_key", where: raw("unpublished_at IS NULL AND scope_id IS NULL"))
  @@index([courseId, unpublishedAt])
  @@index([scopeType, scopeId])
  @@map("course_publications")
}

/// Trainers an administrator has put in charge of a course's content (ADR-0023): they change its
/// outline and details, publish it to the batches they teach, and see it whole.
model CourseStaff {
  courseId     String   @map("course_id") @db.Uuid
  trainerId    String   @map("trainer_id") @db.Uuid
  assignedById String?  @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  trainer TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@id([courseId, trainerId])
  @@index([trainerId])
  @@map("course_staff")
}

// ───────────────────────── progress ─────────────────────────

/// Derived from publications: one row per student per course they can reach.
model Enrollment {
  id             String           @id @default(uuid(7)) @db.Uuid
  studentId      String           @map("student_id") @db.Uuid
  courseId       String           @map("course_id") @db.Uuid
  /// Which publication brought them in (programme, batch or the whole institute).
  source         String           @default("publication") @db.VarChar(40)
  status         EnrollmentStatus @default(active)
  progressPct    Int              @default(0) @map("progress_pct")
  enrolledAt     DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz
  completedAt    DateTime?        @map("completed_at") @db.Timestamptz
  lastAccessedAt DateTime?        @map("last_accessed_at") @db.Timestamptz

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([courseId, status])
  @@map("enrollments")
}

/// How far one learner got in one lesson.
model LessonProgress {
  id              String               @id @default(uuid(7)) @db.Uuid
  studentId       String               @map("student_id") @db.Uuid
  lessonId        String               @map("lesson_id") @db.Uuid
  status          LessonProgressStatus @default(not_started)
  positionSeconds Int                  @default(0) @map("position_seconds")
  watchedPct      Int                  @default(0) @map("watched_pct")
  /// Seconds of video the server has credited as watched: between two progress reports it grows
  /// by how far playback moved, never by more than the time that really passed (Phase 2, D2).
  watchedSeconds  Int                  @default(0) @map("watched_seconds")
  /// When the last progress report arrived, so the next one is measured against real time.
  lastProgressAt  DateTime?            @map("last_progress_at") @db.Timestamptz
  completedAt     DateTime?            @map("completed_at") @db.Timestamptz
  lastAccessedAt  DateTime             @default(now()) @map("last_accessed_at") @db.Timestamptz

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@index([studentId, lastAccessedAt])
  @@map("lesson_progress")
}

/// Append-only feed of what a person did, for the activity list and later analytics.
model ActivityEvent {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  type           String   @db.VarChar(60)
  entityType     String   @default("") @map("entity_type") @db.VarChar(40)
  entityId       String?  @map("entity_id") @db.Uuid
  title          String   @default("") @db.VarChar(200)
  link           String?  @db.VarChar(300)
  payload        Json     @default("{}")
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz
  idempotencyKey String?  @unique @map("idempotency_key") @db.VarChar(120)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@map("activity_events")
}

// ───────────────────────── schedule ─────────────────────────

/// A repeating class: the same subject, days and times over a date range.
model SessionSeries {
  id          String       @id @default(uuid(7)) @db.Uuid
  batchId     String       @map("batch_id") @db.Uuid
  subject     String       @db.VarChar(60)
  title       String       @default("") @db.VarChar(160)
  trainerId   String?      @map("trainer_id") @db.Uuid
  weekdays    String[]     @default([])
  startsTime  String       @map("starts_time") @db.VarChar(5)
  endsTime    String       @map("ends_time") @db.VarChar(5)
  fromDate    DateTime     @map("from_date") @db.Date
  untilDate   DateTime     @map("until_date") @db.Date
  joinUrl     String       @default("") @map("join_url") @db.VarChar(500)
  provider    String       @default("none") @db.VarChar(20)
  skipDates   String[]     @default([]) @map("skip_dates")
  status      SeriesStatus @default(active)
  createdById String?      @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  batch    Batch           @relation(fields: [batchId], references: [id], onDelete: Cascade)
  trainer  TrainerProfile? @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  sessions LiveSession[]

  @@index([batchId, status])
  @@map("session_series")
}

/// One class at one time. Generated from a series, or created on its own.
model LiveSession {
  id                       String        @id @default(uuid(7)) @db.Uuid
  seriesId                 String?       @map("series_id") @db.Uuid
  batchId                  String        @map("batch_id") @db.Uuid
  trainerId                String?       @map("trainer_id") @db.Uuid
  subject                  String        @db.VarChar(60)
  title                    String        @default("") @db.VarChar(160)
  startsAt                 DateTime      @map("starts_at") @db.Timestamptz
  endsAt                   DateTime      @map("ends_at") @db.Timestamptz
  joinUrl                  String        @default("") @map("join_url") @db.VarChar(500)
  provider                 String        @default("none") @db.VarChar(20)
  status                   SessionStatus @default(scheduled)
  notes                    String        @default("") @db.VarChar(1000)
  recordingLessonId        String?       @map("recording_lesson_id") @db.Uuid
  /// Set once the "starting soon" reminder has gone out, so it is never sent twice.
  reminderSentAt           DateTime?     @map("reminder_sent_at") @db.Timestamptz
  /// When the roll call was taken. Null means nobody has marked this class.
  attendanceMarkedAt       DateTime?     @map("attendance_marked_at") @db.Timestamptz
  attendanceMarkedById     String?       @map("attendance_marked_by_id") @db.Uuid
  /// Set once the "you have not marked this class" nudge has gone out, so it is never sent twice.
  attendanceReminderSentAt DateTime?     @map("attendance_reminder_sent_at") @db.Timestamptz
  createdAt                DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  series             SessionSeries?     @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  batch              Batch              @relation(fields: [batchId], references: [id], onDelete: Cascade)
  trainer            TrainerProfile?    @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  recordingLesson    Lesson?            @relation(fields: [recordingLessonId], references: [id], onDelete: SetNull)
  attendanceMarkedBy User?              @relation("SessionAttendanceMarkedBy", fields: [attendanceMarkedById], references: [id], onDelete: SetNull)
  attendance         AttendanceRecord[]

  @@index([batchId, startsAt])
  @@index([trainerId, startsAt])
  @@index([status, startsAt])
  @@map("live_sessions")
}

// ───────────────────────── question bank ─────────────────────────

/// A reusable question. Assignments and tests point at it; editing it bumps a version.
model Question {
  id             String             @id @default(uuid(7)) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  slug           String             @unique @db.VarChar(160)
  title          String             @db.VarChar(200)
  body           String
  type           QuestionType
  /// Taxonomy term keys, not labels.
  subject        String             @default("") @db.VarChar(60)
  topic          String             @default("") @db.VarChar(60)
  difficulty     QuestionDifficulty @default(easy)
  marks          Int                @default(1)
  negativeMarks  Decimal            @default(0) @map("negative_marks") @db.Decimal(5, 2)
  explanation    String             @default("")
  /// What a person marks a written answer against.
  rubric         String             @default("")
  /// Nudges a learner can open one at a time, in order.
  hints          String[]           @default([])
  /// What a file-upload, practical or project answer must contain (types, links, checklist).
  spec           Json               @default("{}")
  tags           String[]           @default([])
  status         QuestionStatus     @default(draft)
  version        Int                @default(1)
  /// Result of the last reference-solution run; a coding question cannot be published without one.
  validation     Json?
  /// Practice catalogue (plan M-14): a published coding question an author chose to surface.
  inPractice     Boolean            @default(false) @map("in_practice")
  practicePoints Int                @default(10) @map("practice_points")
  authorId       String?            @map("author_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?          @map("deleted_at") @db.Timestamptz

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  author              User?                @relation("QuestionAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  options             QuestionOption[]
  coding              CodingProblem?
  versions            QuestionVersion[]
  assignmentQuestions AssignmentQuestion[]
  testQuestions       TestQuestion[]
  submissions         Submission[]
  executionRuns       ExecutionRun[]
  kitItems            CompanyKitItem[]
  labDrafts           LabDraft[]
  aiConversations     AiConversation[]

  @@index([organizationId, status, type])
  @@index([subject, topic, difficulty])
  @@index([inPractice, status])
  @@map("questions")
}

/// One choice of a multiple-choice or true/false question.
model QuestionOption {
  id          String  @id @default(uuid(7)) @db.Uuid
  questionId  String  @map("question_id") @db.Uuid
  body        String  @db.VarChar(2000)
  isCorrect   Boolean @default(false) @map("is_correct")
  explanation String  @default("") @db.VarChar(2000)
  position    Int

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, position])
  @@map("question_options")
}

/// The extra material a coding question carries.
model CodingProblem {
  id                String   @id @default(uuid(7)) @db.Uuid
  questionId        String   @unique @map("question_id") @db.Uuid
  languages         String[] @default([])
  /// { language: source }
  starterCode       Json     @default("{}") @map("starter_code")
  /// Kept server-side and never sent to a learner.
  referenceSolution Json     @default("{}") @map("reference_solution")
  timeLimitMs       Int      @default(5000) @map("time_limit_ms")
  memoryLimitMb     Int      @default(128) @map("memory_limit_mb")
  /// Shown with the statement: what the input looks like, what to print, the bounds.
  inputFormat       String   @default("") @map("input_format")
  outputFormat      String   @default("") @map("output_format")
  constraints       String   @default("")
  /// How output is compared with the expected output: exact, trim, tokens, unordered_lines,
  /// float; for SQL, rows or rows_unordered.
  compareMode       String   @default("trim") @map("compare_mode") @db.VarChar(20)
  /// SQL: the schema and rows every case starts from (run in a throwaway database).
  setupSql          String   @default("") @map("setup_sql")
  /// SQL that changes data: the query whose result is compared, run after the learner's.
  sqlCheck          String   @default("") @map("sql_check")
  /// Debugging: what the program should do once it is fixed (ADR-0018).
  expectedBehaviour String   @default("") @map("expected_behaviour")
  /// SQL: the dataset's tables and columns as the sandbox read them (ADR-0020). Cleared whenever
  /// the dataset changes; null until read.
  sqlSchema         Json?    @map("sql_schema")

  question  Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  testCases TestCase[]

  @@map("coding_problems")
}

/// One input and the output it must produce. Sample cases are shown; hidden ones are only counted.
model TestCase {
  id             String  @id @default(uuid(7)) @db.Uuid
  problemId      String  @map("problem_id") @db.Uuid
  input          String  @default("")
  expectedOutput String  @default("") @map("expected_output")
  isSample       Boolean @default(false) @map("is_sample")
  weight         Int     @default(1)
  position       Int
  /// A short name a learner sees for a visible case ("Empty array").
  label          String  @default("") @db.VarChar(120)
  /// Why this case exists; shown to staff, and to the learner for visible cases.
  explanation    String  @default("")
  /// A disabled case is kept but not run.
  enabled        Boolean @default(true)
  /// Per-case limits; null means the problem's own.
  timeLimitMs    Int?    @map("time_limit_ms")
  memoryLimitMb  Int?    @map("memory_limit_mb")

  problem CodingProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, position])
  @@map("test_cases")
}

/// A snapshot of a question each time it changed, so a paper can say which wording was used.
model QuestionVersion {
  id          String   @id @default(uuid(7)) @db.Uuid
  questionId  String   @map("question_id") @db.Uuid
  version     Int
  /// The whole question as it was, including its options and coding problem.
  snapshot    Json
  summary     String   @default("") @db.VarChar(240)
  changedById String?  @map("changed_by_id") @db.Uuid
  changedAt   DateTime @default(now()) @map("changed_at") @db.Timestamptz

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, version])
  @@map("question_versions")
}

// ───────────────────────── assignments ─────────────────────────

/// A practice set: modules of questions drawn from the bank, published to batches.
model Assignment {
  id               String           @id @default(uuid(7)) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  title            String           @db.VarChar(160)
  description      String           @default("") @db.VarChar(2000)
  /// The technology it practises: a key of the `subject` taxonomy (java, sql, python, …).
  subject          String           @default("") @db.VarChar(60)
  /// The level: a key of the `course-level` taxonomy.
  difficulty       String           @default("") @db.VarChar(40)
  kind             AssignmentKind   @default(mixed)
  /// What the learner reads before starting: rules, what "done" means, how it is marked.
  instructions     String           @default("")
  estimatedMinutes Int              @default(0) @map("estimated_minutes")
  /// Share of the marks that counts as a pass.
  passPercent      Int              @default(40) @map("pass_percent")
  programId        String?          @map("program_id") @db.Uuid
  courseId         String?          @map("course_id") @db.Uuid
  status           AssignmentStatus @default(draft)
  /// { attemptsPerQuestion, explanationPolicy, duePolicy, gradingMethod }
  settings         Json             @default("{}")
  createdById      String?          @map("created_by_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  program      Program?                @relation(fields: [programId], references: [id], onDelete: SetNull)
  course       Course?                 @relation(fields: [courseId], references: [id], onDelete: SetNull)
  modules      AssignmentModule[]
  publications AssignmentPublication[]
  submissions  Submission[]
  resources    AssignmentResource[]

  @@index([organizationId, status])
  @@index([courseId])
  @@map("assignments")
}

/// An ordered group of questions inside an assignment, with its own unlock rule.
model AssignmentModule {
  id             String   @id @default(uuid(7)) @db.Uuid
  assignmentId   String   @map("assignment_id") @db.Uuid
  title          String   @db.VarChar(160)
  description    String   @default("") @db.VarChar(1000)
  /// The topic it covers: a key of the `topic` taxonomy.
  topic          String   @default("") @db.VarChar(60)
  /// The course module it follows, when it has one.
  courseModuleId String?  @map("course_module_id") @db.Uuid
  /// Due this many days after the assignment opens for the learner; null when it has no date.
  dueAfterDays   Int?     @map("due_after_days")
  position       Int
  /// { type: "always" } or { type: "after_previous", minPercent: n }
  unlockRule     Json     @default("{\"type\":\"always\"}") @map("unlock_rule")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  assignment   Assignment           @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  courseModule CourseModule?        @relation(fields: [courseModuleId], references: [id], onDelete: SetNull)
  questions    AssignmentQuestion[]

  @@unique([assignmentId, position])
  @@map("assignment_modules")
}

/// One question placed in a module, with the marks this assignment gives it.
model AssignmentQuestion {
  id         String @id @default(uuid(7)) @db.Uuid
  moduleId   String @map("module_id") @db.Uuid
  questionId String @map("question_id") @db.Uuid
  marks      Int    @default(1)
  position   Int

  module      AssignmentModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  question    Question         @relation(fields: [questionId], references: [id], onDelete: Restrict)
  submissions Submission[]

  @@unique([moduleId, position])
  @@index([questionId])
  @@map("assignment_questions")
}

/// An assignment given to a batch or to one learner, with the dates it runs between.
model AssignmentPublication {
  id            String    @id @default(uuid(7)) @db.Uuid
  assignmentId  String    @map("assignment_id") @db.Uuid
  /// Exactly one of batchId and studentId is set.
  batchId       String?   @map("batch_id") @db.Uuid
  studentId     String?   @map("student_id") @db.Uuid
  /// Before this it is listed as upcoming and cannot be opened.
  opensAt       DateTime? @map("opens_at") @db.Timestamptz
  dueAt         DateTime? @map("due_at") @db.Timestamptz
  /// After this nothing more can be submitted, late or not.
  closesAt      DateTime? @map("closes_at") @db.Timestamptz
  note          String    @default("") @db.VarChar(240)
  publishedById String?   @map("published_by_id") @db.Uuid
  publishedAt   DateTime  @default(now()) @map("published_at") @db.Timestamptz
  withdrawnAt   DateTime? @map("withdrawn_at") @db.Timestamptz

  assignment Assignment      @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  batch      Batch?          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student    StudentProfile? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// One live publication per assignment and batch, and per assignment and learner (Phase 5).
  @@unique([assignmentId, batchId], map: "assignment_publications_live_batch_key", where: raw("withdrawn_at IS NULL AND batch_id IS NOT NULL"))
  @@unique([assignmentId, studentId], map: "assignment_publications_live_learner_key", where: raw("withdrawn_at IS NULL AND student_id IS NOT NULL"))
  @@index([assignmentId, withdrawnAt])
  @@index([batchId, withdrawnAt])
  @@index([studentId, withdrawnAt])
  @@map("assignment_publications")
}

/// Reading or a download that goes with an assignment: a link or an uploaded file.
model AssignmentResource {
  id           String   @id @default(uuid(7)) @db.Uuid
  assignmentId String   @map("assignment_id") @db.Uuid
  title        String   @db.VarChar(160)
  url          String   @default("") @db.VarChar(500)
  fileId       String?  @map("file_id") @db.Uuid
  position     Int
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, position])
  @@map("assignment_resources")
}

/// One answer to one assignment question. Every attempt is kept, so history survives.
model Submission {
  id                   String           @id @default(uuid(7)) @db.Uuid
  assignmentId         String           @map("assignment_id") @db.Uuid
  assignmentQuestionId String           @map("assignment_question_id") @db.Uuid
  questionId           String           @map("question_id") @db.Uuid
  studentId            String           @map("student_id") @db.Uuid
  attempt              Int              @default(1)
  status               SubmissionStatus @default(awaiting_grading)
  marks                Decimal          @default(0) @db.Decimal(6, 2)
  maxMarks             Int              @default(1) @map("max_marks")
  /// Chosen option ids for the objective types.
  optionIds            String[]         @default([]) @map("option_ids") @db.Uuid
  /// What the learner wrote, for a descriptive answer.
  text                 String           @default("")
  /// What the learner submitted, for a coding answer.
  code                 String           @default("")
  language             String           @default("") @db.VarChar(40)
  timeSpentSeconds     Int              @default(0) @map("time_spent_seconds")
  /// File, practical and project answers: { links: [...], checklist: {...}, notes }.
  payload              Json             @default("{}")
  /// Uploaded files handed in with the answer.
  fileIds              String[]         @default([]) @map("file_ids") @db.Uuid
  /// The question's version when it was answered, so a later edit cannot rewrite history.
  questionVersion      Int              @default(1) @map("question_version")
  /// Sent by the client with each submit; the same key twice returns the first submission.
  idempotencyKey       String?          @map("idempotency_key") @db.VarChar(64)
  /// Evaluation of code: who ran it, how it went, what it cost.
  driver               String           @default("") @db.VarChar(40)
  trust                TrustLevel?
  passedCount          Int              @default(0) @map("passed_count")
  totalCount           Int              @default(0) @map("total_count")
  durationMs           Int?             @map("duration_ms")
  memoryKb             Int?             @map("memory_kb")
  compileOutput        String           @default("") @map("compile_output")
  evaluationError      String           @default("") @map("evaluation_error") @db.VarChar(500)
  evaluatedAt          DateTime?        @map("evaluated_at") @db.Timestamptz
  /// The marks the evaluation gave, kept when a reviewer changes `marks`.
  autoMarks            Decimal?         @map("auto_marks") @db.Decimal(6, 2)
  /// The latest review decision, cached from `reviews`.
  reviewDecision       ReviewDecision?  @map("review_decision")
  reviewedAt           DateTime?        @map("reviewed_at") @db.Timestamptz
  graderComment        String           @default("") @map("grader_comment") @db.VarChar(2000)
  gradedById           String?          @map("graded_by_id") @db.Uuid
  gradedAt             DateTime?        @map("graded_at") @db.Timestamptz
  submittedAt          DateTime         @default(now()) @map("submitted_at") @db.Timestamptz
  /// Handed in after the learner's due date, where the publication still accepted it.
  isLate               Boolean          @default(false) @map("is_late")

  assignment         Assignment         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentQuestion AssignmentQuestion @relation(fields: [assignmentQuestionId], references: [id], onDelete: Cascade)
  question           Question           @relation(fields: [questionId], references: [id], onDelete: Restrict)
  student            StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  results            SubmissionResult[]
  reviews            SubmissionReview[]

  @@unique([assignmentQuestionId, studentId, attempt])
  @@unique([studentId, idempotencyKey])
  @@index([studentId, assignmentId])
  @@index([status, submittedAt])
  @@index([assignmentId, status])
  @@map("submissions")
}

/// One test case outcome for a coding submission, as reported by the driver that ran it.
model SubmissionResult {
  id           String            @id @default(uuid(7)) @db.Uuid
  submissionId String            @map("submission_id") @db.Uuid
  testCaseId   String?           @map("test_case_id") @db.Uuid
  passed       Boolean           @default(false)
  verdict      ExecutionVerdict?
  actualOutput String            @default("") @map("actual_output")
  stderr       String            @default("")
  durationMs   Int               @default(0) @map("duration_ms")
  memoryKb     Int?              @map("memory_kb")
  /// Copied from the case when it ran, so the record stands even if the case changes later.
  isSample     Boolean           @default(false) @map("is_sample")
  weight       Int               @default(1)
  position     Int               @default(0)

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("submission_results")
}

/// A reviewer's decision on a submission. Never edited: a second look is a second row.
model SubmissionReview {
  id           String         @id @default(uuid(7)) @db.Uuid
  submissionId String         @map("submission_id") @db.Uuid
  reviewerId   String?        @map("reviewer_id") @db.Uuid
  decision     ReviewDecision
  /// Marks the reviewer gave; null keeps the evaluated marks.
  marks        Decimal?       @db.Decimal(6, 2)
  comment      String         @default("") @db.VarChar(4000)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer   User?      @relation("SubmissionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([submissionId, createdAt])
  @@map("submission_reviews")
}

// ───────────────────────── tests ─────────────────────────

/// A timed paper: sections of questions, settings, and windows per batch.
model Test {
  id             String     @id @default(uuid(7)) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  title          String     @db.VarChar(160)
  description    String     @default("") @db.VarChar(2000)
  kind           TestKind   @default(weekly)
  subject        String     @default("") @db.VarChar(60)
  instructions   String     @default("")
  status         TestStatus @default(draft)
  /// { durationMinutes, maxAttempts, shuffle*, resultPolicy, reviewPolicy, … }
  settings       Json       @default("{}")
  createdById    String?    @map("created_by_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?  @map("deleted_at") @db.Timestamptz

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sections     TestSection[]
  schedules    TestSchedule[]
  attempts     TestAttempt[]

  @@index([organizationId, status])
  @@map("tests")
}

model TestSection {
  id           String @id @default(uuid(7)) @db.Uuid
  testId       String @map("test_id") @db.Uuid
  title        String @db.VarChar(160)
  instructions String @default("") @db.VarChar(5000)
  position     Int

  test      Test           @relation(fields: [testId], references: [id], onDelete: Cascade)
  questions TestQuestion[]

  @@unique([testId, position])
  @@map("test_sections")
}

model TestQuestion {
  id            String  @id @default(uuid(7)) @db.Uuid
  sectionId     String  @map("section_id") @db.Uuid
  questionId    String  @map("question_id") @db.Uuid
  marks         Int     @default(1)
  negativeMarks Decimal @default(0) @map("negative_marks") @db.Decimal(5, 2)
  position      Int

  section  TestSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  question Question     @relation(fields: [questionId], references: [id], onDelete: Restrict)
  answers  TestAnswer[]

  @@unique([sectionId, position])
  @@index([questionId])
  @@map("test_questions")
}

/// A window during which one batch may sit the test.
model TestSchedule {
  id           String    @id @default(uuid(7)) @db.Uuid
  testId       String    @map("test_id") @db.Uuid
  batchId      String    @map("batch_id") @db.Uuid
  opensAt      DateTime  @map("opens_at") @db.Timestamptz
  closesAt     DateTime  @map("closes_at") @db.Timestamptz
  /// Overrides the test's own attempt limit for this batch when set.
  maxAttempts  Int?      @map("max_attempts")
  releasedAt   DateTime? @map("released_at") @db.Timestamptz
  releasedById String?   @map("released_by_id") @db.Uuid
  createdById  String?   @map("created_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  test     Test          @relation(fields: [testId], references: [id], onDelete: Cascade)
  batch    Batch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  attempts TestAttempt[]

  @@unique([testId, batchId])
  @@index([opensAt, closesAt])
  @@map("test_schedules")
}

/// One sitting. The deadline is the server's; the client only counts down to it.
model TestAttempt {
  id            String        @id @default(uuid(7)) @db.Uuid
  testId        String        @map("test_id") @db.Uuid
  scheduleId    String        @map("schedule_id") @db.Uuid
  studentId     String        @map("student_id") @db.Uuid
  attempt       Int           @default(1)
  status        AttemptStatus @default(in_progress)
  startedAt     DateTime      @default(now()) @map("started_at") @db.Timestamptz
  expiresAt     DateTime      @map("expires_at") @db.Timestamptz
  submittedAt   DateTime?     @map("submitted_at") @db.Timestamptz
  /// True when the deadline submitted it rather than the learner.
  autoSubmitted Boolean       @default(false) @map("auto_submitted")
  score         Decimal       @default(0) @db.Decimal(7, 2)
  totalMarks    Int           @default(0) @map("total_marks")
  /// Integrity signals the client reported. Recorded and shown, never used to block.
  tabSwitches   Int           @default(0) @map("tab_switches")
  integrityLog  Json          @default("[]") @map("integrity_log")
  lastSavedAt   DateTime?     @map("last_saved_at") @db.Timestamptz
  /// The order questions were shown in, when the paper is shuffled.
  questionOrder String[]      @default([]) @map("question_order") @db.Uuid

  test     Test           @relation(fields: [testId], references: [id], onDelete: Cascade)
  schedule TestSchedule   @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  student  StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers  TestAnswer[]

  @@unique([scheduleId, studentId, attempt])
  @@index([testId, status])
  @@index([status, expiresAt])
  @@map("test_attempts")
}

/// One answer inside an attempt, rewritten by every autosave.
model TestAnswer {
  id               String           @id @default(uuid(7)) @db.Uuid
  attemptId        String           @map("attempt_id") @db.Uuid
  testQuestionId   String           @map("test_question_id") @db.Uuid
  optionIds        String[]         @default([]) @map("option_ids") @db.Uuid
  text             String           @default("")
  code             String           @default("")
  language         String           @default("") @db.VarChar(40)
  flagged          Boolean          @default(false)
  timeSpentSeconds Int              @default(0) @map("time_spent_seconds")
  status           SubmissionStatus @default(awaiting_grading)
  marks            Decimal          @default(0) @db.Decimal(6, 2)
  graderComment    String           @default("") @map("grader_comment") @db.VarChar(2000)
  gradedById       String?          @map("graded_by_id") @db.Uuid
  gradedAt         DateTime?        @map("graded_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  attempt      TestAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  testQuestion TestQuestion @relation(fields: [testQuestionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, testQuestionId])
  @@index([status])
  @@map("test_answers")
}

// ───────────────────────── code execution ─────────────────────────

/// Every run of learner code, whoever ran it. The API never executes any of it (ADR-0007).
model ExecutionRun {
  id          String           @id @default(uuid(7)) @db.Uuid
  questionId  String?          @map("question_id") @db.Uuid
  userId      String?          @map("user_id") @db.Uuid
  /// practice, assignment, test or validation.
  context     String           @default("practice") @db.VarChar(20)
  language    String           @db.VarChar(40)
  code        String           @default("")
  driver      String           @db.VarChar(40)
  trust       TrustLevel       @default(untrusted)
  verdict     ExecutionVerdict @default(pending)
  passedCount Int              @default(0) @map("passed_count")
  totalCount  Int              @default(0) @map("total_count")
  durationMs  Int              @default(0) @map("duration_ms")
  /// Per-case detail as the driver reported it.
  detail      Json             @default("[]")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz

  question Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  user     User?     @relation("ExecutionRunUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([questionId, userId, createdAt])
  @@index([context, createdAt])
  @@map("execution_runs")
}

/// A learner's unfinished work in a lab, or in the playground per language, kept on the server so
/// it follows them between devices (ADR-0018). The learner's own; deleted with them.
model LabDraft {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  /// The lab, or null for the playground.
  questionId String?  @map("question_id") @db.Uuid
  /// "playground" or the lab's question id, so (user, scope, language) is unique.
  scope      String   @db.VarChar(40)
  language   String   @db.VarChar(20)
  code       String   @default("")
  /// Playground only: the input the program reads.
  stdin      String   @default("")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, language])
  @@index([userId, updatedAt])
  @@map("lab_drafts")
}

// ───────────────────────── phase 4 enums ─────────────────────────

enum QuestionType {
  mcq_single
  mcq_multi
  true_false
  descriptive
  coding
  sql
  file_upload
  practical
  project
  /// A broken program the learner fixes; Labs only until Roadmap Phase 3 (ADR-0018).
  debugging
  /// A web page in HTML, CSS and JavaScript, marked by checks in the sandbox (ADR-0019).
  web
}

/// From first steps to company-style rounds; the order a learner meets them in.
enum QuestionDifficulty {
  easy
  medium
  hard
  beginner
  foundation
  interview
  company
}

enum QuestionStatus {
  draft
  published
  retired
}

enum AssignmentStatus {
  draft
  published
  archived
}

enum SubmissionStatus {
  correct
  incorrect
  partial
  awaiting_grading
  /// Code waiting for, or being run by, the sandbox.
  evaluating
  /// The sandbox could not evaluate it (not the learner's fault); it can be run again.
  error
}

/// What an assignment asks for, as the list and filters show it.
enum AssignmentKind {
  coding
  sql
  quiz
  written
  file_upload
  practical
  project
  mixed
}

enum ReviewDecision {
  graded
  approved
  resubmission_requested
}

enum TestStatus {
  draft
  published
  archived
}

enum TestKind {
  practice
  weekly
  mock
  final
}

enum AttemptStatus {
  in_progress
  submitted
  graded
  abandoned
}

enum TrustLevel {
  untrusted
  trusted
}

enum ExecutionVerdict {
  passed
  failed
  error
  timeout
  pending
  wrong_answer
  runtime_error
  memory_limit
  compile_error
  output_limit
}

// ═══════════════════════ Phase 5 — attendance and reporting ═══════════════════════
// Modules: attendance, reports (report pages and export jobs).

/// One student's mark for one class. The row exists only once the roll call has been taken, so
/// an unmarked class counts towards nobody's percentage.
model AttendanceRecord {
  id               String           @id @default(uuid(7)) @db.Uuid
  sessionId        String           @map("session_id") @db.Uuid
  studentId        String           @map("student_id") @db.Uuid
  /// Copied from the session so a batch percentage is one index scan; the session owns the truth.
  batchId          String           @map("batch_id") @db.Uuid
  status           AttendanceStatus
  note             String           @default("") @db.VarChar(300)
  markedById       String?          @map("marked_by_id") @db.Uuid
  markedAt         DateTime         @default(now()) @map("marked_at") @db.Timestamptz
  correctedById    String?          @map("corrected_by_id") @db.Uuid
  correctedAt      DateTime?        @map("corrected_at") @db.Timestamptz
  /// Why the mark was changed. The API requires one for every correction (plan AC-05.2).
  correctionReason String           @default("") @map("correction_reason") @db.VarChar(300)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  session     LiveSession            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student     StudentProfile         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batch       Batch                  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  markedBy    User?                  @relation("AttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)
  correctedBy User?                  @relation("AttendanceCorrectedBy", fields: [correctedById], references: [id], onDelete: SetNull)
  corrections AttendanceCorrection[]

  @@unique([sessionId, studentId])
  @@index([studentId, markedAt])
  @@index([batchId, status])
  @@map("attendance_records")
}

/// Every change to a mark already taken, oldest first: from what, to what, by whom and why
/// (AC-05.2). The record keeps only its latest state; this keeps the rest (Phases 3–4, TRN-04).
model AttendanceCorrection {
  id            String           @id @default(uuid(7)) @db.Uuid
  recordId      String           @map("record_id") @db.Uuid
  fromStatus    AttendanceStatus @map("from_status")
  toStatus      AttendanceStatus @map("to_status")
  reason        String           @db.VarChar(300)
  correctedById String?          @map("corrected_by_id") @db.Uuid
  correctedAt   DateTime         @default(now()) @map("corrected_at") @db.Timestamptz

  record AttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId, correctedAt])
  @@map("attendance_corrections")
}

/// A requested export. A job writes the file and the row records what it contains; the link
/// expires with the object, so a download never outlives the data it was allowed to show.
model ReportExport {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  report         String       @db.VarChar(40)
  format         String       @db.VarChar(10)
  /// The filters the report page had applied, so the file matches what was on the screen.
  params         Json         @default("{}")
  status         ExportStatus @default(queued)
  rowCount       Int?         @map("row_count")
  sizeBytes      Int?         @map("size_bytes")
  filename       String       @default("") @db.VarChar(200)
  objectKey      String       @default("") @map("object_key") @db.VarChar(400)
  error          String       @default("") @db.VarChar(500)
  requestedById  String?      @map("requested_by_id") @db.Uuid
  requestedAt    DateTime     @default(now()) @map("requested_at") @db.Timestamptz
  startedAt      DateTime?    @map("started_at") @db.Timestamptz
  completedAt    DateTime?    @map("completed_at") @db.Timestamptz
  expiresAt      DateTime?    @map("expires_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy  User?        @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([organizationId, requestedAt])
  @@index([status])
  @@map("report_exports")
}

enum AttendanceStatus {
  present
  absent
  late
  excused
}

enum ExportStatus {
  queued
  running
  ready
  failed
  expired
}

// ═══════════════════════ Phase 6 — demo completion ═══════════════════════
// Modules: profile (the learner's own record), settings (content pages, email templates,
// integration configuration).

/// A CV a learner uploaded. The file itself lives in the private bucket; this row is what the
/// platform knows about it, including which one is offered by default.
model Resume {
  id         String   @id @default(uuid(7)) @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  fileId     String   @map("file_id") @db.Uuid
  title      String   @default("") @db.VarChar(120)
  isDefault  Boolean  @default(false) @map("is_default")
  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamptz

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, uploadedAt])
  @@map("resumes")
}

/// A page of the institute's own words — terms, privacy, anything else — shown at /pages/<slug>.
model ContentPage {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  slug           String   @db.VarChar(64)
  title          String   @db.VarChar(160)
  body           String   @default("")
  /// A draft is reachable only by somebody who may manage settings.
  isPublished    Boolean  @default(false) @map("is_published")
  updatedById    String?  @map("updated_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, slug])
  @@map("content_pages")
}

/// The wording of one kind of email. The platform ships defaults; a client edits them here.
model EmailTemplate {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String   @db.VarChar(64)
  subject        String   @db.VarChar(200)
  bodyHtml       String   @default("") @map("body_html")
  bodyText       String   @default("") @map("body_text")
  updatedById    String?  @map("updated_by_id") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("email_templates")
}

/// Which driver a provider uses and how it is configured. The secret is stored apart from the
/// rest and never returned by the API — a client can replace it, never read it back.
model IntegrationConfig {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  provider       String   @db.VarChar(40)
  driver         String   @db.VarChar(40)
  /// Everything that is safe to show: hosts, buckets, sender addresses.
  config         Json     @default("{}")
  /// Write-only. Present or absent is all the API will say about it.
  secret         String   @default("")
  updatedById    String?  @map("updated_by_id") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@map("integration_configs")
}

// ───────────────────────── Task 2: placement and doubts ─────────────────────────
// Modules: placement (companies, interview-prep kits, drives and applications; ADR-0014) and
// doubts (a learner's question on a course or lesson, answered by their trainers).

enum DriveStatus {
  draft
  open
  closed
}

enum ApplicationStatus {
  applied
  shortlisted
  selected
  rejected
  withdrawn
}

enum DoubtStatus {
  open
  answered
  resolved
}

/// A company the institute prepares learners for and places them with.
model Company {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  slug           String    @db.VarChar(80)
  name           String    @db.VarChar(120)
  industry       String    @default("") @db.VarChar(80)
  website        String    @default("") @db.VarChar(300)
  description    String    @default("") @db.VarChar(2000)
  logoFileId     String?   @map("logo_file_id") @db.Uuid
  /// Technologies its interview-prep kit covers (subject keys, e.g. core-java, sql).
  technologies   String[]  @default([])
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  kitItems     CompanyKitItem[]
  favourites   CompanyFavourite[]
  drives       PlacementDrive[]

  @@unique([organizationId, slug])
  @@index([organizationId, deletedAt])
  @@map("companies")
}

/// One practice problem in a company's interview-prep kit. Kits reuse the practice catalogue, so a
/// learner solves a kit question in the same workspace and it counts the same way.
model CompanyKitItem {
  id         String   @id @default(uuid(7)) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  topic      String   @default("") @db.VarChar(80)
  position   Int
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([companyId, questionId])
  @@index([companyId, position])
  @@map("company_kit_items")
}

/// A company a learner starred, so its kit is one tap away.
model CompanyFavourite {
  userId    String   @map("user_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@map("company_favourites")
}

/// A recruitment drive a company runs through the institute.
model PlacementDrive {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  companyId      String      @map("company_id") @db.Uuid
  /// A short reference learners and staff quote, e.g. DRV-2026-014.
  code           String      @db.VarChar(32)
  role           String      @db.VarChar(120)
  /// full_time or internship.
  employmentType String      @default("full_time") @map("employment_type") @db.VarChar(20)
  location       String      @default("") @db.VarChar(120)
  /// As the company states it, e.g. "4.5 – 6 LPA".
  packageText    String      @default("") @map("package_text") @db.VarChar(80)
  description    String      @default("") @db.VarChar(4000)
  /// { batchIds: uuid[], programIds: uuid[], minAttendancePct: number | null }. Empty lists mean anyone.
  eligibility    Json        @default("{}")
  applyBy        DateTime    @map("apply_by") @db.Timestamptz
  status         DriveStatus @default(draft)
  publishedAt    DateTime?   @map("published_at") @db.Timestamptz
  createdById    String?     @map("created_by_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company      Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  applications DriveApplication[]

  @@unique([organizationId, code])
  @@index([organizationId, status, applyBy])
  @@map("placement_drives")
}

/// A learner's application to one drive; staff move it through the stages.
model DriveApplication {
  id          String            @id @default(uuid(7)) @db.Uuid
  driveId     String            @map("drive_id") @db.Uuid
  studentId   String            @map("student_id") @db.Uuid
  /// The resume sent with the application (the learner's default at the time).
  resumeId    String?           @map("resume_id") @db.Uuid
  status      ApplicationStatus @default(applied)
  /// What staff tell the learner about the latest stage.
  note        String            @default("") @db.VarChar(1000)
  appliedAt   DateTime          @default(now()) @map("applied_at") @db.Timestamptz
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  updatedById String?           @map("updated_by_id") @db.Uuid

  drive   PlacementDrive @relation(fields: [driveId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([driveId, studentId])
  @@index([studentId, status])
  @@map("drive_applications")
}

/// A learner's question about a course or a lesson, answered by the trainers of their batch.
model Doubt {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  studentId      String      @map("student_id") @db.Uuid
  courseId       String?     @map("course_id") @db.Uuid
  lessonId       String?     @map("lesson_id") @db.Uuid
  title          String      @db.VarChar(160)
  body           String      @db.VarChar(4000)
  status         DoubtStatus @default(open)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  resolvedAt     DateTime?   @map("resolved_at") @db.Timestamptz

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course       Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  lesson       Lesson?        @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  replies      DoubtReply[]

  @@index([studentId, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([lessonId])
  @@map("doubts")
}

/// One message in a doubt's thread, from the learner or a member of staff.
model DoubtReply {
  id        String   @id @default(uuid(7)) @db.Uuid
  doubtId   String   @map("doubt_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String   @db.VarChar(4000)
  fromStaff Boolean  @default(false) @map("from_staff")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  doubt  Doubt @relation(fields: [doubtId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([doubtId, createdAt])
  @@map("doubt_replies")
}

// ───────────────────────── feedback (F-18) ─────────────────────────

/// A feedback form given to a batch (F-18, Phases 3–4 D10): answered once, or every week from
/// Friday to Sunday (AC-13.1).
model FeedbackForm {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  title          String    @db.VarChar(160)
  description    String    @default("") @db.VarChar(1000)
  batchId        String    @map("batch_id") @db.Uuid
  /// The trainer it is about, who sees its figures.
  trainerId      String?   @map("trainer_id") @db.Uuid
  courseId       String?   @map("course_id") @db.Uuid
  anonymous      Boolean   @default(true)
  /// "once" or "weekly".
  cadence        String    @default("once") @db.VarChar(10)
  /// [{ id, kind: rating | choice | text, prompt, required, options[] }]
  questions      Json
  opensAt        DateTime  @map("opens_at") @db.Timestamptz
  closesAt       DateTime? @map("closes_at") @db.Timestamptz
  /// The last round its learners were told about, so each round is announced once.
  notifiedPeriod String?   @map("notified_period") @db.VarChar(10)
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  batch        Batch              @relation(fields: [batchId], references: [id], onDelete: Cascade)
  trainer      TrainerProfile?    @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  course       Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)
  responses    FeedbackResponse[]

  @@index([organizationId, deletedAt])
  @@index([batchId])
  @@index([trainerId])
  @@map("feedback_forms")
}

/// One learner's answers to one round of a form (E-47). An anonymous form's answer names nobody:
/// no learner, a random id and the day only. The respondent token, a keyed hash of the form, the
/// round and the learner, stops a second answer without saying whose the first was (AC-13.2).
model FeedbackResponse {
  id              String   @id @default(uuid(4)) @db.Uuid
  formId          String   @map("form_id") @db.Uuid
  /// "once", or the Friday a weekly round opened on (YYYY-MM-DD, institute time).
  period          String   @db.VarChar(10)
  respondentToken String   @map("respondent_token") @db.VarChar(64)
  /// Only when the form is not anonymous.
  studentId       String?  @map("student_id") @db.Uuid
  answers         Json
  submittedOn     DateTime @map("submitted_on") @db.Date

  form    FeedbackForm    @relation(fields: [formId], references: [id], onDelete: Cascade)
  student StudentProfile? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@unique([formId, period, respondentToken])
  @@map("feedback_responses")
}

// ───────────────────────── SI Academy AI (Phase 7C) ─────────────────────────

enum AiPurpose {
  assistant
  workspace
  lab_hint
}

enum AiConversationStatus {
  active
  archived
}

enum AiMessageRole {
  user
  assistant
}

enum AiMessageStatus {
  streaming
  complete
  failed
  cancelled
  blocked
}

/// Who wrote a conversation's title (Phase 7D): its owner when starting it, the first line of its
/// first question (Phase 7C), or the model, once, in the background.
enum AiTitleSource {
  user
  question
  model
}

/// Whose a cached answer is (Phase 7D; ADR-0032): `shared` for a general learning question with
/// nothing of a person in it, `user` for one person alone.
enum AiCacheScope {
  shared
  user
}

/// A person's conversation with SI Academy AI (ADR-0030). Its owner's alone: there is no staff view
/// (a later ADR would decide one). A deleted one is hidden at once and purged by retention (7D).
model AiConversation {
  id                  String               @id @default(uuid(7)) @db.Uuid
  organizationId      String               @map("organization_id") @db.Uuid
  userId              String               @map("user_id") @db.Uuid
  purpose             AiPurpose
  /// What it is about, each checked against what the owner could open when it was set.
  courseId            String?              @map("course_id") @db.Uuid
  lessonId            String?              @map("lesson_id") @db.Uuid
  questionId          String?              @map("question_id") @db.Uuid
  title               String               @default("") @db.VarChar(120)
  titleSource         AiTitleSource        @default(question) @map("title_source")
  /// Taken by the job writing a title, for as long as it writes it (Phase 7D).
  titleClaimedAt      DateTime?            @map("title_claimed_at") @db.Timestamptz
  /// Notes on the older turns, written by the model (Phase 7D): context for later answers, never
  /// instructions, never authority. Empty until the conversation is long enough.
  summary             String               @default("")
  /// The time of the last message the summary covers; null while there is none.
  summarizedThroughAt DateTime?            @map("summarized_through_at") @db.Timestamptz
  /// Taken by the job writing the summary, for as long as it writes it (Phase 7D).
  summaryClaimedAt    DateTime?            @map("summary_claimed_at") @db.Timestamptz
  status              AiConversationStatus @default(active)
  lastMessageAt       DateTime?            @map("last_message_at") @db.Timestamptz
  deletedAt           DateTime?            @map("deleted_at") @db.Timestamptz
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  course       Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  lesson       Lesson?        @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  question     Question?      @relation(fields: [questionId], references: [id], onDelete: SetNull)
  messages     AiMessage[]
  requests     AiRequest[]
  cacheEntries AiCacheEntry[]

  @@index([userId, lastMessageAt(sort: Desc)])
  /// What the retention sweep looks for (Phase 7D): only deleted conversations are indexed.
  @@index([deletedAt], map: "ai_conversations_deleted_at_idx", where: raw("deleted_at IS NOT NULL"))
  @@map("ai_conversations")
}

/// One message (ADR-0030). Append-only: a question is written once; an answer is written once,
/// when it ends — a regeneration would be another message. An answer that does not complete keeps
/// no text. Provenance and usage are kept for the owner's records, never shown to a browser.
model AiMessage {
  id              String          @id @default(uuid(7)) @db.Uuid
  conversationId  String          @map("conversation_id") @db.Uuid
  /// The conversation's owner: one answer at a time per person is enforced on it.
  userId          String          @map("user_id") @db.Uuid
  role            AiMessageRole
  content         String          @default("")
  status          AiMessageStatus
  provider        String?         @db.VarChar(20)
  model           String?         @db.VarChar(80)
  promptVersion   String?         @map("prompt_version") @db.VarChar(40)
  dataClass       String?         @map("data_class") @db.VarChar(20)
  inputTokens     Int?            @map("input_tokens")
  outputTokens    Int?            @map("output_tokens")
  tokensEstimated Boolean         @default(false) @map("tokens_estimated")
  latencyMs       Int?            @map("latency_ms")
  finishReason    String?         @map("finish_reason") @db.VarChar(20)
  /// Why an answer did not complete, as a code; never a provider's message.
  errorCode       String?         @map("error_code") @db.VarChar(40)
  /// The policy's reasons for the call's data class, as codes.
  policyFlags     String[]        @default([]) @map("policy_flags")
  /// The messages the answer was built from, by id (traceability, ADR-0028), and the summary it
  /// used, as `summary:<the time it covers to>` (Phase 7D).
  contextRefs     Json            @default("[]") @map("context_refs")
  /// The cached answer that served it (Phase 7D); null when a model wrote it.
  cacheEntryId    String?         @map("cache_entry_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
  completedAt     DateTime?       @map("completed_at") @db.Timestamptz

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  cacheEntry   AiCacheEntry?  @relation(fields: [cacheEntryId], references: [id], onDelete: SetNull)
  requests     AiRequest[]

  /// One answer being written per person, however many requests race (Phase 7C): the generation
  /// gate. It opens again when the answer ends, whichever way.
  @@unique([userId], map: "ai_messages_one_generation_per_user_key", where: raw("status = 'streaming'"))
  @@index([conversationId, createdAt])
  @@index([userId, status])
  /// What the retention sweep reads (Phase 7D).
  @@index([createdAt])
  @@map("ai_messages")
}

/// One call to a provider (ADR-0028, ADR-0029): for whom, for what, which model, its tokens, its
/// estimated cost, its latency and how it ended. The usage ledger; never the prompt or the answer.
model AiRequest {
  id                  String   @id @default(uuid(7)) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  /// Null once the person's data is erased: the institute's figures keep the call.
  userId              String?  @map("user_id") @db.Uuid
  conversationId      String?  @map("conversation_id") @db.Uuid
  messageId           String?  @map("message_id") @db.Uuid
  feature             String   @db.VarChar(20)
  task                String   @db.VarChar(20)
  dataClass           String   @map("data_class") @db.VarChar(20)
  provider            String   @db.VarChar(20)
  model               String   @db.VarChar(80)
  /// `ok`, or the failure kind (`unavailable`, `timeout`, `cancelled`, …).
  outcome             String   @db.VarChar(20)
  fallback            Boolean  @default(false)
  inputTokens         Int      @default(0) @map("input_tokens")
  outputTokens        Int      @default(0) @map("output_tokens")
  totalTokens         Int      @default(0) @map("total_tokens")
  tokensEstimated     Boolean  @default(false) @map("tokens_estimated")
  /// Millionths of a US dollar, from AI_MODEL_COSTS; null when the model has no price.
  estimatedCostMicros Int?     @map("estimated_cost_micros")
  latencyMs           Int      @default(0) @map("latency_ms")
  requestId           String?  @map("request_id") @db.VarChar(64)
  /// The institute day the call was counted on (Phase 7D), as the daily totals count it: the
  /// usage roll-up reads it, so a later change of time zone never moves a call to another day.
  day                 DateTime @db.Date
  /// The call that carried a person's question (Phase 7D): one per answered question, however many
  /// calls it took; a title or a summary carries none.
  countsAsQuestion    Boolean  @default(false) @map("counts_as_question")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  conversation AiConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message      AiMessage?      @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, day])
  @@index([conversationId])
  @@index([messageId])
  @@map("ai_requests")
}

/// A person's AI usage for one day in the institute's time zone (ADR-0029): what the daily quotas
/// are checked against, and what the monthly budget adds up.
model AiUsageDaily {
  id                  String   @id @default(uuid(7)) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  /// Null once the person's data is erased: the institute's totals keep the day.
  userId              String?  @map("user_id") @db.Uuid
  day                 DateTime @db.Date
  requests            Int      @default(0)
  inputTokens         Int      @default(0) @map("input_tokens")
  outputTokens        Int      @default(0) @map("output_tokens")
  totalTokens         Int      @default(0) @map("total_tokens")
  /// Calls whose tokens are estimates.
  estimatedRequests   Int      @default(0) @map("estimated_requests")
  estimatedCostMicros Int      @default(0) @map("estimated_cost_micros")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([userId, day])
  @@index([organizationId, day])
  @@map("ai_usage_daily")
}

/// An answer kept for reuse (Phase 7D; ADR-0032). The Phase 7 cache matches a normalised question
/// exactly; similarity matching, with embeddings and pgvector, is Phase 8's. Only a complete answer
/// to a general question asked on its own is kept. A `shared` entry holds nothing of a person: no
/// person, conversation or message is linked to it. A `user` entry is its person's alone, goes with
/// the conversation it was answered in, and is erased with them. Every hit is checked again against
/// the asker's reach of what the answer drew on (`sources`); the entry itself grants nothing.
model AiCacheEntry {
  id                 String       @id @default(uuid(7)) @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  scope              AiCacheScope
  userId             String?      @map("user_id") @db.Uuid
  conversationId     String?      @map("conversation_id") @db.Uuid
  /// SHA-256 of everything a reuse must match: scope, person, surface, data class, language,
  /// model family, prompt version, knowledge version and the normalised question.
  keyHash            String       @map("key_hash") @db.Char(64)
  normalizedQuestion String       @map("normalized_question") @db.VarChar(400)
  answer             String
  purpose            AiPurpose
  dataClass          String       @map("data_class") @db.VarChar(20)
  language           String       @db.VarChar(10)
  provider           String       @db.VarChar(20)
  /// The exact model that wrote it; another model routed now makes it stale.
  model              String       @db.VarChar(80)
  modelFamily        String       @map("model_family") @db.VarChar(40)
  promptVersion      String       @map("prompt_version") @db.VarChar(40)
  /// What the answer knew (Phase 8 sets it from its sources); `none` in Phase 7.
  knowledgeVersion   String       @map("knowledge_version") @db.VarChar(40)
  /// What the answer drew on, as `{ kind, id }`: each is re-checked on every hit.
  sources            Json         @default("[]")
  hitCount           Int          @default(0) @map("hit_count")
  lastHitAt          DateTime?    @map("last_hit_at") @db.Timestamptz
  expiresAt          DateTime     @map("expires_at") @db.Timestamptz
  invalidatedAt      DateTime?    @map("invalidated_at") @db.Timestamptz
  /// Why it may not be reused: `model`, `knowledge`, `prompt` or `admin`.
  invalidationReason String?      @map("invalidation_reason") @db.VarChar(20)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation AiConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messages     AiMessage[]

  @@unique([organizationId, keyHash])
  @@index([expiresAt])
  @@index([userId])
  @@map("ai_cache_entries")
}

// ───────────────────────── SI Academy AI: the knowledge base (Roadmap Phase 8A; ADR-0033) ─────────────────────────
//
// What SI Academy AI may later draw on, kept as the institute's own: a source holds documents, a
// document has versions, a version is cut into chunks. Every row carries the whole key of where it
// came from — institute, source, document, version — and the database holds each one to its
// parent's (composite foreign keys), so a chunk can never claim another document's or institute's
// material. No vector column lives here: embeddings arrive in Phase 8C, in a table of their own
// (ADR-0026, ADR-0027). Knowledge is retrieved only by `KnowledgeReachService`'s rules.

/// What a knowledge source holds, for the people who manage it.
enum KnowledgeSourceType {
  /// Text written for the knowledge base itself.
  authored
  /// Documents uploaded to it (ingested from Phase 8B).
  uploaded
  /// A course's own published material, kept in step with the course (Phase 8B).
  course
}

/// Who may draw on a published source (ADR-0033).
enum KnowledgeAudience {
  /// Everyone in the institute who may ask SI Academy AI.
  institute
  /// Staff only — trainers and administrators — never a learner.
  staff
  /// The people the source's course reaches: its learners, and the trainers it is published to.
  course
}

enum KnowledgeSourceStatus {
  draft
  published
  /// For good: an archived source is never published again.
  archived
}

enum KnowledgeDocumentStatus {
  active
  archived
}

/// A version's ingestion: written, taken by an ingestion job, cut into chunks, or failed.
enum KnowledgeVersionStatus {
  pending
  processing
  chunked
  failed
}

model KnowledgeSource {
  id             String                @id @default(uuid(7)) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  name           String                @db.VarChar(160)
  description    String                @default("") @db.VarChar(2000)
  type           KnowledgeSourceType
  audience       KnowledgeAudience
  /// The course of a course-audience source; null for every other audience (checked in the database).
  courseId       String?               @map("course_id") @db.Uuid
  /// The most sensitive data the source holds (ADR-0024): public, course or personal — never restricted.
  dataClass      String                @map("data_class") @db.VarChar(20)
  status         KnowledgeSourceStatus @default(draft)
  createdById    String?               @map("created_by_id") @db.Uuid
  publishedAt    DateTime?             @map("published_at") @db.Timestamptz
  archivedAt     DateTime?             @map("archived_at") @db.Timestamptz
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  course       Course?             @relation(fields: [courseId], references: [id], onDelete: Restrict)
  createdBy    User?               @relation("KnowledgeSourceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  documents    KnowledgeDocument[]

  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([courseId])
  @@map("knowledge_sources")
}

model KnowledgeDocument {
  id             String                  @id @default(uuid(7)) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  sourceId       String                  @map("source_id") @db.Uuid
  title          String                  @db.VarChar(200)
  /// The document's stable identity in its source, for citations and later ingestion runs:
  /// `lesson:<id>`, an uploaded file's path, an authored document's own slug.
  canonicalRef   String                  @map("canonical_ref") @db.VarChar(400)
  /// The lesson a course source's document is about: then only people who reach that lesson draw on it.
  lessonId       String?                 @map("lesson_id") @db.Uuid
  status         KnowledgeDocumentStatus @default(active)
  createdById    String?                 @map("created_by_id") @db.Uuid
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz

  source    KnowledgeSource            @relation(fields: [sourceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  lesson    Lesson?                    @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  createdBy User?                      @relation("KnowledgeDocumentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  versions  KnowledgeDocumentVersion[]

  @@unique([sourceId, canonicalRef])
  @@unique([id, sourceId, organizationId])
  @@index([organizationId])
  @@index([lessonId])
  @@map("knowledge_documents")
}

model KnowledgeDocumentVersion {
  id                 String                 @id @default(uuid(7)) @db.Uuid
  organizationId     String                 @map("organization_id") @db.Uuid
  sourceId           String                 @map("source_id") @db.Uuid
  documentId         String                 @map("document_id") @db.Uuid
  /// 1, 2, 3… within the document.
  version            Int
  /// SHA-256 of the content, normalised (NFC, LF line ends, no trailing spaces): the same content
  /// in another form has the same hash, so a version is never kept twice.
  contentHash        String                 @map("content_hash") @db.Char(64)
  /// Where the content is stored, through the platform's storage driver: never in this table.
  fileId             String                 @unique @map("file_id") @db.Uuid
  characterCount     Int                    @map("character_count")
  status             KnowledgeVersionStatus @default(pending)
  /// The version answers may draw on: the newest one fully chunked. One per document, and only a
  /// chunked one (both checked in the database).
  isCurrent          Boolean                @default(false) @map("is_current")
  chunkCount         Int                    @default(0) @map("chunk_count")
  /// Why ingestion failed, as a code — never the content.
  failureCode        String?                @map("failure_code") @db.VarChar(60)
  chunkedAt          DateTime?              @map("chunked_at") @db.Timestamptz
  /// The parser that read the content into its structure (Phase 8B), e.g. `markdown-1`.
  parserVersion      String?                @map("parser_version") @db.VarChar(40)
  /// The chunker and its sizes that cut the chunks (Phase 8B): the same content and the same
  /// chunker give the same chunks, and 8C knows which chunker it embeds.
  chunkerVersion     String?                @map("chunker_version") @db.VarChar(60)
  /// When the ingestion that holds the version took it: its lease, and the token its writes check.
  ingestionStartedAt DateTime?              @map("ingestion_started_at") @db.Timestamptz
  createdById        String?                @map("created_by_id") @db.Uuid
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  document   KnowledgeDocument           @relation(fields: [documentId, sourceId, organizationId], references: [id, sourceId, organizationId], onDelete: Restrict)
  file       File                        @relation(fields: [fileId], references: [id], onDelete: Restrict)
  createdBy  User?                       @relation("KnowledgeVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  chunks     KnowledgeChunk[]
  embeddings KnowledgeVersionEmbedding[]

  @@unique([documentId, version])
  @@unique([documentId, contentHash])
  @@unique([id, documentId, sourceId, organizationId])
  @@unique([documentId], map: "knowledge_document_versions_one_current_key", where: raw("is_current"))
  @@index([organizationId, status])
  @@map("knowledge_document_versions")
}

model KnowledgeChunk {
  id             String   @id @default(uuid(7)) @db.Uuid
  /// The chunk's provenance, on the row: institute → source → document → version. Retrieval filters
  /// need no joins for it, and the database holds the whole key to the version's own.
  organizationId String   @map("organization_id") @db.Uuid
  sourceId       String   @map("source_id") @db.Uuid
  documentId     String   @map("document_id") @db.Uuid
  versionId      String   @map("version_id") @db.Uuid
  /// Its place in the version, from 0.
  position       Int
  /// The heading it falls under, for citations; empty when there is none.
  heading        String   @default("") @db.VarChar(300)
  content        String
  /// SHA-256 of the chunk's normalised text: the same text, the same hash, in any version.
  contentHash    String   @map("content_hash") @db.Char(64)
  characterCount Int      @map("character_count")
  /// About four characters a token: an estimate, until the embedding model's own count (Phase 8C).
  tokenEstimate  Int      @map("token_estimate")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  version    KnowledgeDocumentVersion  @relation(fields: [versionId, documentId, sourceId, organizationId], references: [id, documentId, sourceId, organizationId], onDelete: Cascade)
  embeddings KnowledgeChunkEmbedding[]

  @@unique([versionId, position])
  /// The whole key, so that an embedding can hold its chunk's provenance to it (Phase 8C).
  @@unique([id, versionId, documentId, sourceId, organizationId])
  @@index([organizationId, sourceId])
  @@index([documentId])
  @@index([contentHash])
  @@map("knowledge_chunks")
}

/// Where a version's embedding stands under one embedding contract (Phase 8C; ADR-0035).
enum KnowledgeEmbeddingStatus {
  pending
  embedding
  embedded
  failed
}

/// A version's embedding run under one embedding contract — provider, model, dimension and the
/// platform's embedding version (Phase 8C; ADR-0035): asked for, claimed by one worker under a
/// lease, embedded, or failed with a code. Another contract is another run, and another set of
/// vectors: they are never compared.
model KnowledgeVersionEmbedding {
  id               String                   @id @default(uuid(7)) @db.Uuid
  organizationId   String                   @map("organization_id") @db.Uuid
  sourceId         String                   @map("source_id") @db.Uuid
  documentId       String                   @map("document_id") @db.Uuid
  versionId        String                   @map("version_id") @db.Uuid
  provider         String                   @db.VarChar(20)
  model            String                   @db.VarChar(80)
  dimension        Int
  embeddingVersion String                   @map("embedding_version") @db.VarChar(40)
  status           KnowledgeEmbeddingStatus @default(pending)
  /// The version's chunks when the run last counted them, and how many have a valid embedding.
  chunkCount       Int                      @default(0) @map("chunk_count")
  embeddedCount    Int                      @default(0) @map("embedded_count")
  /// Runs that took the version: a retry is one more.
  attempts         Int                      @default(0)
  /// Why the last run failed, as a code — never content.
  failureCode      String?                  @map("failure_code") @db.VarChar(60)
  /// Who asked for it last: the usage ledger counts the provider's calls for them (ADR-0029).
  requestedById    String?                  @map("requested_by_id") @db.Uuid
  /// When the run that holds it took it: its lease, and the token its writes check.
  claimedAt        DateTime?                @map("claimed_at") @db.Timestamptz
  embeddedAt       DateTime?                @map("embedded_at") @db.Timestamptz
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  version     KnowledgeDocumentVersion @relation(fields: [versionId, documentId, sourceId, organizationId], references: [id, documentId, sourceId, organizationId], onDelete: Cascade)
  requestedBy User?                    @relation("KnowledgeEmbeddingRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  @@unique([versionId, provider, model, dimension, embeddingVersion])
  @@index([organizationId, status])
  @@index([documentId])
  @@map("knowledge_version_embeddings")
}

/// One chunk's vector under one embedding contract (Phase 8C; ADR-0035). It carries the chunk's
/// whole provenance, held to the chunk by a composite key, and the hash of the text it was made
/// from: a vector is valid only while that is the chunk's hash, under the active contract. What a
/// person may draw on is never read from here alone: retrieval (Phase 8D) joins the source and the
/// document and applies the reach rule (ADR-0033). Its HNSW cosine index
/// (`knowledge_chunk_embeddings_embedding_hnsw_idx`) is in the migration's raw SQL: Prisma cannot
/// describe it, so a schema diff shows it as a `DROP INDEX` that must never be applied (runbook).
model KnowledgeChunkEmbedding {
  id               String                     @id @default(uuid(7)) @db.Uuid
  organizationId   String                     @map("organization_id") @db.Uuid
  sourceId         String                     @map("source_id") @db.Uuid
  documentId       String                     @map("document_id") @db.Uuid
  versionId        String                     @map("version_id") @db.Uuid
  chunkId          String                     @map("chunk_id") @db.Uuid
  contentHash      String                     @map("content_hash") @db.Char(64)
  provider         String                     @db.VarChar(20)
  model            String                     @db.VarChar(80)
  dimension        Int
  embeddingVersion String                     @map("embedding_version") @db.VarChar(40)
  /// Unit length; the column's type enforces the dimension (ADR-0035).
  embedding        Unsupported("vector(768)")
  createdAt        DateTime                   @default(now()) @map("created_at") @db.Timestamptz

  chunk KnowledgeChunk @relation(fields: [chunkId, versionId, documentId, sourceId, organizationId], references: [id, versionId, documentId, sourceId, organizationId], onDelete: Cascade)

  @@unique([chunkId, provider, model, dimension, embeddingVersion])
  @@index([organizationId, sourceId])
  @@index([versionId])
  @@index([documentId])
  @@map("knowledge_chunk_embeddings")
}
