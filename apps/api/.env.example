# API environment (apps/api). Copy to .env. Values below are LOCAL defaults; staging/production must set their own.
# Every variable is validated at boot (src/core/config/env.ts); the API refuses to start with missing or invalid values.

APP_ENV=local                      # local | staging | production
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
CLIENT_KEY=demo                    # selects the client overlay under clients/<key>
LOG_LEVEL=debug                    # trace | debug | info | warn | error

# Database (PostgreSQL). Matches infra/compose.yml defaults.
DATABASE_URL=postgresql://lms:lms_dev_password@localhost:5433/lms?schema=public
# Connections the API keeps open (default 20); raise it with the database's max_connections.
DATABASE_POOL_MAX=20

# Authentication
JWT_ACCESS_SECRET=change-me-local-access-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
# Seals the secrets stored in the database (integration passwords; operations runbook §6).
# Empty: a key derived from JWT_ACCESS_SECRET. Outside local, set a long random value; changing it
# means entering the stored secrets again.
DATA_ENCRYPTION_KEY=
COOKIE_SECURE=false                # true behind HTTPS (staging/production)
COOKIE_DOMAIN=                     # empty = host-only cookie

# Cross-origin
CORS_ORIGINS=http://localhost:3000

# Background jobs: embedded runs pg-boss workers inside the API process; separate uses apps/worker
WORKER_MODE=embedded
QUEUE_DRIVER=pgboss

# File storage (S3-compatible). Local: MinIO from infra/compose.yml
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
# Where browsers reach the store, for signed upload/download links. Empty: S3_ENDPOINT, which the
# browser reaches locally. In containers set the public https host; an internal one is refused.
S3_PRESIGN_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=lmsminio
S3_SECRET_KEY=lms_minio_password
S3_BUCKET_PRIVATE=lms-private
S3_BUCKET_PUBLIC=lms-public
S3_FORCE_PATH_STYLE=true

# Email. Local: Mailpit (catches everything at http://localhost:8025)
EMAIL_DRIVER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM=SI Academy <no-reply@siacademy.example>

# Where learners' code runs (ADR-0016). The API never runs it itself.
#   runner - the sandbox runner in apps/runner (default): one locked-down container per job
#   judge0 - a Judge0 host (Linux only; no SQL)
#   none   - nothing runs; coding answers wait for a person
EXECUTION_DRIVER=runner
RUNNER_URL=http://127.0.0.1:4100
# The same value as in apps/runner/.env, at least 32 characters (pnpm env:init sets both).
RUNNER_TOKEN=
JUDGE0_URL=
JUDGE0_TOKEN=

# SI Academy AI (Roadmap Phase 7; ADR-0024). Off unless a provider is chosen:
#   none   - the default when unset (and on staging): AI answers nothing
#   fake   - a deterministic stand-in for local development and tests; refused outside local. The
#            local default here since Phase 8C: knowledge can be embedded offline, with no key
#   gemini - Google's Gemini API; needs GEMINI_API_KEY and AI_MODEL, and is chosen deliberately
# The module flag `module.ai` must also be on before anyone sees an AI surface.
AI_PROVIDER=fake
# The model every task uses: one the model registry lists for the provider
# (apps/api/src/modules/ai/routing/model-registry.ts), e.g. gemini-3.8-flash. Empty with fake: fake-1.
AI_MODEL=
# Optional per-task models, as task=model pairs (tasks: chat, hint, classify, title, summarize),
# e.g. title=gemini-3.5-flash-lite,summarize=gemini-3.5-flash-lite
AI_TASK_MODELS=
# Optional: another model of the same provider that answers while AI_MODEL is overloaded or resting.
AI_FALLBACK_MODEL=
# How long one AI call may take, streaming included, in milliseconds (1000 to 300000).
AI_TIMEOUT_MS=60000
# The data classes the provider is approved for (ADR-0024): public, course, personal. Add course for
# course material, personal only once the provider's data-use terms are verified and recorded.
# restricted is never allowed. Empty approves nothing.
AI_DATA_CLASSES=public
# Optional estimated prices, model=input/output in US dollars per million tokens, from the provider's
# price list, e.g. gemini-3.8-flash=0.50/3.00 (ADR-0029).
AI_MODEL_COSTS=
# Each person's daily allowance (Phase 7C), in the institute's time zone: questions sent to a provider,
# and the tokens they used, input and output together. At the limit, the next question waits a day.
# These, the budget below, the models above and AI_DATA_CLASSES are the deployment's defaults: the
# Super Admin's AI settings (Phase 7D) may set the institute's own, and narrow the data classes.
AI_USER_DAILY_REQUESTS=50
AI_USER_DAILY_TOKENS=100000
# Optional monthly budget for the institute in US dollars, against the estimates above; empty: none.
# Set, every model the router may use needs a price in AI_MODEL_COSTS, or the API refuses to start.
AI_ORG_MONTHLY_BUDGET_USD=
# The longest answer asked for, in tokens, a thinking model's reasoning included (256 to 65536).
AI_MAX_OUTPUT_TOKENS=4096
# Local only: the fake provider's pause between streamed words, in milliseconds, to watch streaming.
AI_FAKE_DELAY_MS=0
# Knowledge embeddings (Phase 8C; ADR-0035). Empty model: the provider's own (fake-embedding-2,
# gemini-embedding-001). The dimension is the schema's vector(768): another needs a migration first,
# and the API refuses to start with it. Texts per call to the provider: 1 to 100.
# Google's price list (1 October 2026) shows no price for gemini-embedding-001: with a monthly budget
# set, add one to AI_MODEL_COSTS (gemini-embedding-001=<input>/0) from your own billing, or nothing
# is embedded.
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSION=768
AI_EMBEDDING_BATCH_SIZE=32
# Grounded answers (Phase 8E; ADR-0037): the least similarity a passage needs to be evidence, more
# than 0 and at most 1 (three decimals). Empty: the measured floor of the embedding model in use -
# the fake's is built in; gemini-embedding-001 has none until it is measured (runbook, "Answering
# from knowledge"), and grounded answers are refused until then.
AI_KNOWLEDGE_ANSWER_MIN_SIMILARITY=
# Gemini only. The key stays on the server: never in a URL, a response, a log line or the database.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1

# Seeds (local only; staging must set explicit values). Values are read with Node's .env loader:
# a "#" inside a value starts a comment, so avoid "#" in these passwords or quote the whole value.
SEED_ADMIN_EMAIL=superadmin@siacademy.example
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
