{
  "name": "@lms/api",
  "version": "0.1.0",
  "private": true,
  "description": "LMS platform API (NestJS modular monolith; worker runs embedded or separate)",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "tsx prisma/seed/base.ts",
    "db:seed:demo": "tsx prisma/seed/demo.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "cli": "tsx src/cli/main.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1131.0",
    "@aws-sdk/s3-request-presigner": "3.1131.0",
    "@lms/module-sdk": "workspace:*",
    "@lms/shared": "workspace:*",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/event-emitter": "12.0.0",
    "@nestjs/jwt": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "exceljs": "4.4.0",
    "helmet": "8.3.0",
    "nestjs-pino": "5.1.0",
    "nodemailer": "10.0.9",
    "pg": "8.23.0",
    "pg-boss": "12.31.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@lms/config": "workspace:*",
    "@nestjs/cli": "12.0.0",
    "@nestjs/schematics": "12.0.1",
    "@nestjs/testing": "12.0.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.20.2",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "globals": "17.12.0",
    "pino-pretty": "13.1.3",
    "prisma": "7.10.0",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11"
  }
}
