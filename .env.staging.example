# Staging on one VM (architecture plan §9.1, Option A). Copy to .env.staging and fill it in.
# Nothing in this file is a secret until you replace the placeholders; the real file is git-ignored.
#
#   docker compose --env-file .env.staging -f infra/compose.staging.yml up -d
#
# Staging holds demonstration data only. Never point it at a real institute's records (plan §9.5).

# ── where it lives ────────────────────────────────────────────────────────────
# A hostname that resolves to this VM. A free DuckDNS subdomain works; Caddy gets the
# certificate from Let's Encrypt on first start, which needs ports 80 and 443 open.
STAGING_HOST=lms-demo.duckdns.org
ACME_EMAIL=you@example.com

# ── images ────────────────────────────────────────────────────────────────────
# Where CI pushed them, e.g. ghcr.io/<owner>. IMAGE_TAG is the git sha CI tagged, or `latest`.
IMAGE_REGISTRY=ghcr.io/your-account
IMAGE_TAG=latest

# ── database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=lms
POSTGRES_PASSWORD=replace-me-with-a-long-random-string
POSTGRES_DB=lms

# ── tokens ────────────────────────────────────────────────────────────────────
# Generate each separately: openssl rand -base64 32
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me-differently
# Shared by the API and the sandbox runner only (ADR-0016); at least 32 characters.
RUNNER_TOKEN=replace-me-with-a-long-random-string

# ── the sandbox runner ────────────────────────────────────────────────────────
# The runner starts each job's container through this VM's Docker socket, which belongs to the
# docker group. Its id on this VM: getent group docker | cut -d: -f3
DOCKER_GID=
# Jobs checked at once (one CPU each); more wait in a queue.
RUNNER_CONCURRENCY=2

# ── object storage (MinIO on this VM) ─────────────────────────────────────────
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me-with-a-long-random-string
S3_BUCKET_PRIVATE=lms-private
S3_BUCKET_PUBLIC=lms-public

# ── email ─────────────────────────────────────────────────────────────────────
# Mailpit catches everything and delivers nothing, which is what staging wants.
EMAIL_FROM=SI Academy <no-reply@siacademy.example>

# ── the two pages behind a password (mail catcher, uptime monitor) ────────────
# Generate the hash on the VM: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your password'
MAIL_UI_USER=demo
MAIL_UI_PASSWORD_HASH=replace-with-the-hash-caddy-prints

# ── which client's branding to seed ───────────────────────────────────────────
CLIENT_KEY=demo

# ── demo accounts (used once, by the seed) ────────────────────────────────────
SEED_ADMIN_EMAIL=superadmin@siacademy.example
SEED_ADMIN_PASSWORD=replace-me
SEED_DEMO_PASSWORD=replace-me
