# dependencies
node_modules/
.pnpm-store/

# builds
.next/
dist/
out/
.turbo/
coverage/
playwright-report/
test-results/
*.tsbuildinfo

# generated
apps/api/src/generated/

# environment (real values are never committed)
.env
.env.*
!.env.example
!.env.staging.example
# credentials and session state from test runs: QA env files, Playwright sign-ins, network captures
*.env
**/.auth/
*.har

# logs and OS files
*.log
npm-debug.log*
pnpm-debug.log*
.DS_Store
Thumbs.db

# editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# local data
infra/data/

# client-provided source materials (screenshots may contain personal data; keep local)
docs/source-materials/

# local scratch (Playwright temp when the system drive is full)
.tmp/

# Python bytecode (the AWS host scripts and their tests)
__pycache__/
*.pyc
